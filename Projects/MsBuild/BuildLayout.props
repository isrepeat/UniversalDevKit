<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Shared artifact layout for UniversalDevKit's own Static and Dynamic projects.
       When an application imports UDK sources through Sources.targets,
       the application compiles them into its own output directories.
       Skip this import there to preserve the application's build paths. -->
  <PropertyGroup>
    <!-- Resolve paths relative to this file regardless of the working directory or solution location. -->
    <UniversalDevKitArtifactsRoot>$(MSBuildThisFileDirectory)..\..\!artifacts\projects\</UniversalDevKitArtifactsRoot>
    <!-- The default combines OS and architecture as Windows-x64. Callers may set the platform earlier. -->
    <UniversalDevKitTargetPlatform Condition="'$(UniversalDevKitTargetPlatform)' == ''">Windows-$(Platform)</UniversalDevKitTargetPlatform>
    <!-- CRT selection is independent of component linkage. Debug selects the debug CRT. -->
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <__UniversalDevKitRuntimeDirectory Condition="'$(UniversalDevKitRuntime)' == 'Dynamic'">md</__UniversalDevKitRuntimeDirectory>
    <__UniversalDevKitRuntimeDirectory Condition="'$(UniversalDevKitRuntime)' == 'Static'">mt</__UniversalDevKitRuntimeDirectory>
    <__UniversalDevKitRuntimeLibrary Condition="'$(UniversalDevKitRuntime)' == 'Dynamic' and '$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</__UniversalDevKitRuntimeLibrary>
    <__UniversalDevKitRuntimeLibrary Condition="'$(UniversalDevKitRuntime)' == 'Dynamic' and '$(Configuration)' != 'Debug'">MultiThreadedDLL</__UniversalDevKitRuntimeLibrary>
    <__UniversalDevKitRuntimeLibrary Condition="'$(UniversalDevKitRuntime)' == 'Static' and '$(Configuration)' == 'Debug'">MultiThreadedDebug</__UniversalDevKitRuntimeLibrary>
    <__UniversalDevKitRuntimeLibrary Condition="'$(UniversalDevKitRuntime)' == 'Static' and '$(Configuration)' != 'Debug'">MultiThreaded</__UniversalDevKitRuntimeLibrary>
    <!-- Short project names leave room for longer submodule paths. -->
    <__UniversalDevKitArtifactProject>$([System.String]::Copy('$(MSBuildProjectName)').Replace('UniversalDevKit.', ''))</__UniversalDevKitArtifactProject>

		<!-- Separate outputs by platform, build system, project, and configuration.
         bin contains build outputs and obj contains intermediate files. -->
    <OutDir>$(UniversalDevKitArtifactsRoot)$(UniversalDevKitTargetPlatform)\msbuild\$(__UniversalDevKitArtifactProject)\$(PlatformToolset)\$(VCToolsVersion)\$(__UniversalDevKitRuntimeDirectory)\$(Configuration)\bin\</OutDir>
    <IntDir>$(UniversalDevKitArtifactsRoot)$(UniversalDevKitTargetPlatform)\msbuild\$(__UniversalDevKitArtifactProject)\$(PlatformToolset)\$(VCToolsVersion)\$(__UniversalDevKitRuntimeDirectory)\$(Configuration)\obj\</IntDir>
    <TLogLocation>$(IntDir)tlog\</TLogLocation>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary>$(__UniversalDevKitRuntimeLibrary)</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Consumer solutions disable direct library builds. Build transitive references
       in the current library context before linking, even when solution mapping skips them. -->
  <Target Name="__UniversalDevKitEnableLibraryReferenceBuild"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(ProjectReference)' != ''">
    <PropertyGroup>
      <BuildProjectReferences>true</BuildProjectReferences>
    </PropertyGroup>
  </Target>
  <Target Name="__UniversalDevKitConfigureLibraryReferences"
          AfterTargets="AssignProjectConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Condition="$([System.String]::Copy('%(ProjectReferenceWithConfiguration.Filename)').StartsWith('UniversalDevKit.'))">
        <BuildReference>true</BuildReference>
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>
  <Target Name="__UniversalDevKitValidateRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Dynamic' and '$(UniversalDevKitRuntime)' != 'Static'"
           Text="UniversalDevKitRuntime must be Dynamic (MD) or Static (MT)." />
    <Error Condition="'%(ClCompile.RuntimeLibrary)' != '$(__UniversalDevKitRuntimeLibrary)'"
           Text="UniversalDevKit RuntimeLibrary override conflicts with UniversalDevKitRuntime: %(ClCompile.Identity)." />
  </Target>
</Project>