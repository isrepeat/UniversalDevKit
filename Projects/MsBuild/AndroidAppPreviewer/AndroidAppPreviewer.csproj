<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../../!artifacts/projects/windows/msbuild/AndroidAppPreviewer/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputPath>../../../!artifacts/projects/windows/msbuild/AndroidAppPreviewer/bin/$(Configuration)/</OutputPath>
    <PreviewerSource>../../../Sources/Windows/AndroidAppPreviewer</PreviewerSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AndroidAppPreviewerPluginSdk.Managed/AndroidAppPreviewerPluginSdk.Managed.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <ApplicationDefinition Include="$(PreviewerSource)/App.xaml" Link="App.xaml" />
    <Compile Include="$(PreviewerSource)/**/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="$(PreviewerSource)/**/*.xaml" Exclude="$(PreviewerSource)/App.xaml" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="$(PreviewerSource)/Resources/Icons/*.svg" Link="Resources/Icons/%(Filename)%(Extension)" />
    <Content Include="$(PreviewerSource)/Resources/Cursors/*.png" Link="Resources/Cursors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PreviewerSource)/Resources/Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>