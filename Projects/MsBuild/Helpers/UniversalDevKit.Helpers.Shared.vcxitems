<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <HasSharedItems>true</HasSharedItems>
    <ItemsProjectGuid>{F27F4562-11C4-42EF-AC5A-26101FD26F46}</ItemsProjectGuid>
    <UniversalDevKitFilterRoots>Includes\UniversalDevKit\Helpers;Sources\Helpers</UniversalDevKitFilterRoots>
  </PropertyGroup>
