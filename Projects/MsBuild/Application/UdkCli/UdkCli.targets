<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <__UniversalDevKitCliTools>$(MSBuildThisFileDirectory)..\..\..\..\Sources\Windows\UdkCli\Tools\</__UniversalDevKitCliTools>
  </PropertyGroup>
  <Target Name="__UniversalDevKitStageCliTools" AfterTargets="Build">
    <ItemGroup>
      <__UniversalDevKitCliTool Include="$(__UniversalDevKitCliTools)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(__UniversalDevKitCliTool)"
          DestinationFiles="@(__UniversalDevKitCliTool->'$(OutDir)Tools\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>