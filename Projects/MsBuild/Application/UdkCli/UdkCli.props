<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Static</UniversalDevKitRuntime>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>UDK_CLI_VERSION="$(UniversalDevKitGitHubVersion)";UNIVERSALDEVKIT_DIAGNOSTIC_DYNAMIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Diagnostic\UniversalDevKit.Diagnostic.Dynamic.vcxproj">
      <Private>true</Private>
      <AdditionalProperties>UniversalDevKitRuntime=Static</AdditionalProperties>
      <GlobalPropertiesToRemove>OutDir;IntDir</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
</Project>