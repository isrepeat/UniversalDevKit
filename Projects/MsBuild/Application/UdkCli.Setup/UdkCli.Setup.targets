<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="..\UdkCli.Diagnostic.targets" />
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Diagnostic\UniversalDevKit.Diagnostic.Net8.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UdkPayload)' != ''">
    <EmbeddedResource Include="$(UdkPayload)" LogicalName="UdkPayload.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(UdkVsixPayload)' != ''">
    <EmbeddedResource Include="$(UdkVsixPayload)" LogicalName="UdkCli.VisualStudio.vsix" />
  </ItemGroup>
  <Target Name="RequireUdkPayload" BeforeTargets="Publish" Condition="'$(UdkPayload)' == '' Or '$(UdkVsixPayload)' == ''">
    <Error Text="Build the UDK CLI setup through Publish.UdkCli.cmd." />
  </Target>
</Project>