<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Target Name="__UniversalDevKitStageDiagnostic" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Condition="'$(UdkDiagnosticPayload)' == '' And '$(MSBuildRuntimeType)' == 'Full'"
             Projects="$(MSBuildThisFileDirectory)..\Library\Diagnostic\UniversalDevKit.Diagnostic.Dynamic.vcxproj"
             Targets="Build;GetTargetPath"
             Properties="Configuration=Release;Platform=x64;UniversalDevKitRuntime=Static"
             RemoveProperties="OutDir;IntDir;RuntimeIdentifier;TargetFramework;SelfContained;SolutionDir;BuildProjectReferences;BuildingSolutionFile">
      <Output TaskParameter="TargetOutputs" PropertyName="UdkDiagnosticPayload" />
    </MSBuild>
    <Error Condition="!Exists('$(UdkDiagnosticPayload)')" Text="Build with Visual Studio MSBuild or supply the native Diagnostic DLL via UdkDiagnosticPayload." />
    <PropertyGroup>
      <__UniversalDevKitDiagnosticFile>$(IntermediateOutputPath)udk-native\universaldevkit_diagnostic_dynamic.dll</__UniversalDevKitDiagnosticFile>
    </PropertyGroup>
    <Copy SourceFiles="$(UdkDiagnosticPayload)" DestinationFiles="$(__UniversalDevKitDiagnosticFile)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="$(__UniversalDevKitDiagnosticFile)" Link="universaldevkit_diagnostic_dynamic.dll"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" IncludeInVSIX="true" />
    </ItemGroup>
  </Target>
</Project>