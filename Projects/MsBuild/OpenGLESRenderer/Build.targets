<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitAngleRoot Condition="'$(UniversalDevKitAngleRoot)' == ''">$(UDK_ANGLE_ROOT)</UniversalDevKitAngleRoot>
    <__UniversalDevKitAngleInclude>$(UniversalDevKitAngleRoot)\include</__UniversalDevKitAngleInclude>
    <__UniversalDevKitAngleInclude Condition="Exists('$(UniversalDevKitAngleRoot)\build\native\include\GLES3\gl3.h')">$(UniversalDevKitAngleRoot)\build\native\include</__UniversalDevKitAngleInclude>
    <__UniversalDevKitAngleLib>$(UniversalDevKitAngleRoot)\lib</__UniversalDevKitAngleLib>
    <__UniversalDevKitAngleLib Condition="Exists('$(UniversalDevKitAngleRoot)\runtimes\win-x64\native\Release\libEGL.lib')">$(UniversalDevKitAngleRoot)\runtimes\win-x64\native\Release</__UniversalDevKitAngleLib>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(__UniversalDevKitAngleInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories><AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <Link><AdditionalDependencies>$(__UniversalDevKitAngleLib)\libEGL.lib;$(__UniversalDevKitAngleLib)\libGLESv2.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <Target Name="__UniversalDevKitValidateAngle" BeforeTargets="PrepareForBuild"><Error Condition="!Exists('$(__UniversalDevKitAngleInclude)\GLES3\gl3.h')" Text="Set UniversalDevKitAngleRoot or UDK_ANGLE_ROOT to an ANGLE installation." /></Target>
</Project>