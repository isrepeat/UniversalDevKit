<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Подключает исходники выбранных компонентов непосредственно в C++-проект потребителя.
       Connect.cmd добавляет импорт этого файла и свойство UniversalDevKitComponents
       в .vcxproj. Пример значения: Helpers;Diagnostic. Отдельная библиотека не создаётся;
       общий код компилируется с настройками и в каталоги артефактов потребителя. -->
  <Import Project="UniversalDevKit.props" Condition="'$(__IsUniversalDevKitPublicPropsImported)' != 'true'" />

	<PropertyGroup>
    <!-- Разделители с обеих сторон обеспечивают поиск целого имени компонента в списке. -->
    <__HasUniversalDevKitHelpers>$([System.String]::Copy(';$(UniversalDevKitComponents);').Contains(';Helpers;'))</__HasUniversalDevKitHelpers>
    <__HasUniversalDevKitDiagnostic>$([System.String]::Copy(';$(UniversalDevKitComponents);').Contains(';Diagnostic;'))</__HasUniversalDevKitDiagnostic>
  </PropertyGroup>

	<ItemGroup>
    <!-- Преобразуем список в элементы MSBuild для проверки каждого выбранного имени. -->
    <__UniversalDevKitComponent Include="$(UniversalDevKitComponents)" />
  </ItemGroup>

	<!-- Shared-файлы содержат единственные списки исходников; ими также пользуются
       Static/Dynamic-проекты. Здесь файлы не копируются, а добавляются в потребителя. -->
  <Import Project="Helpers\UniversalDevKit.Helpers.Shared.vcxitems" Condition="'$(__HasUniversalDevKitHelpers)' == 'true'" Label="Shared" />
  <Import Project="Diagnostic\UniversalDevKit.Diagnostic.Shared.vcxitems" Condition="'$(__HasUniversalDevKitDiagnostic)' == 'true'" Label="Shared" />

  <Target Name="ValidateUniversalDevKitComponents" BeforeTargets="PrepareForBuild">
	 <!-- Останавливаем сборку до компиляции при пустом списке или неизвестном компоненте. -->
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="UniversalDevKitComponents must be specified." />
    <Error Condition="'%(__UniversalDevKitComponent.Identity)' != 'Helpers' and '%(__UniversalDevKitComponent.Identity)' != 'Diagnostic'"
           Text="Unsupported UniversalDevKit component: %(__UniversalDevKitComponent.Identity)" />
  </Target>
</Project>