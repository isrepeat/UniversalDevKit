<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="UniversalDevKit.props" Condition="'$(UniversalDevKitPublicPropsImported)' != 'true'" />
  <PropertyGroup>
    <_UniversalDevKitHelpers>$([System.String]::Copy(';$(UniversalDevKitComponents);').Contains(';Helpers;'))</_UniversalDevKitHelpers>
    <_UniversalDevKitDiagnostic>$([System.String]::Copy(';$(UniversalDevKitComponents);').Contains(';Diagnostic;'))</_UniversalDevKitDiagnostic>
  </PropertyGroup>
  <ItemGroup>
    <_UniversalDevKitComponent Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Import Project="Helpers\UniversalDevKit.Helpers.Shared.vcxitems" Condition="'$(_UniversalDevKitHelpers)' == 'true'" Label="Shared" />
  <Import Project="Diagnostic\UniversalDevKit.Diagnostic.Shared.vcxitems" Condition="'$(_UniversalDevKitDiagnostic)' == 'true'" Label="Shared" />
  <Target Name="ValidateUniversalDevKitComponents" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="UniversalDevKitComponents must be specified." />
    <Error Condition="'%(_UniversalDevKitComponent.Identity)' != 'Helpers' and '%(_UniversalDevKitComponent.Identity)' != 'Diagnostic'"
           Text="Unsupported UniversalDevKit component: %(_UniversalDevKitComponent.Identity)" />
  </Target>
</Project>