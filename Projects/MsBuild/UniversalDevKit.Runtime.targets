<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Validate the CRT for every file before building references. Shared items keep their settings. -->
  <Target Name="__UniversalDevKitConfigureConsumerRuntime"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <__UniversalDevKitBinaryReference Include="@(ProjectReference)"
                                         Condition="$([System.String]::Copy('%(ProjectReference.Filename)').StartsWith('UniversalDevKit.'))" />
    </ItemGroup>
    <PropertyGroup Condition="'@(__UniversalDevKitBinaryReference)' != ''">
      <__UniversalDevKitConsumerRuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</__UniversalDevKitConsumerRuntimeLibrary>
      <__UniversalDevKitConsumerRuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreadedDLL</__UniversalDevKitConsumerRuntimeLibrary>
    </PropertyGroup>
    <ItemGroup Condition="'@(__UniversalDevKitBinaryReference)' != ''">
      <__UniversalDevKitConsumerRuntimeValue Include="%(ClCompile.RuntimeLibrary)"
                                            Condition="'%(ClCompile.RuntimeLibrary)' != ''" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(__UniversalDevKitConsumerRuntimeValue)">
      <Output TaskParameter="Filtered" ItemName="__UniversalDevKitConsumerUniqueRuntime" />
    </RemoveDuplicates>
    <PropertyGroup Condition="'@(__UniversalDevKitConsumerUniqueRuntime)' != ''">
      <__UniversalDevKitConsumerRuntimeLibrary>@(__UniversalDevKitConsumerUniqueRuntime)</__UniversalDevKitConsumerRuntimeLibrary>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(__UniversalDevKitConsumerRuntimeLibrary)').Contains(';'))"
           Text="UniversalDevKit requires one RuntimeLibrary for all consumer source files." />
    <PropertyGroup Condition="'@(__UniversalDevKitBinaryReference)' != ''">
      <__UniversalDevKitConsumerRuntime Condition="'$(__UniversalDevKitConsumerRuntimeLibrary)' == 'MultiThreadedDLL' or '$(__UniversalDevKitConsumerRuntimeLibrary)' == 'MultiThreadedDebugDLL'">Dynamic</__UniversalDevKitConsumerRuntime>
      <__UniversalDevKitConsumerRuntime Condition="'$(__UniversalDevKitConsumerRuntimeLibrary)' == 'MultiThreaded' or '$(__UniversalDevKitConsumerRuntimeLibrary)' == 'MultiThreadedDebug'">Static</__UniversalDevKitConsumerRuntime>
    </PropertyGroup>
    <Error Condition="'@(__UniversalDevKitBinaryReference)' != '' and '$(__UniversalDevKitConsumerRuntime)' == ''"
           Text="Unsupported consumer RuntimeLibrary for UniversalDevKit." />
    <PropertyGroup>
      <__UniversalDevKitSelectedRuntime Condition="'$(UniversalDevKitRuntime)' == ''">$(__UniversalDevKitConsumerRuntime)</__UniversalDevKitSelectedRuntime>
      <__UniversalDevKitSelectedRuntime Condition="'$(UniversalDevKitRuntime)' != ''">$(UniversalDevKitRuntime)</__UniversalDevKitSelectedRuntime>
    </PropertyGroup>
    <Error Condition="'@(__UniversalDevKitBinaryReference)' != '' and '$(__UniversalDevKitSelectedRuntime)' != '$(__UniversalDevKitConsumerRuntime)'"
           Text="UniversalDevKitRuntime conflicts with consumer RuntimeLibrary. Select the same runtime for this consumer." />
    <PropertyGroup Condition="'@(__UniversalDevKitBinaryReference)' != ''">
      <__UniversalDevKitExpectedConsumerRuntime>MultiThreaded</__UniversalDevKitExpectedConsumerRuntime>
      <__UniversalDevKitExpectedConsumerRuntime Condition="'$(Configuration)' == 'Debug'">$(__UniversalDevKitExpectedConsumerRuntime)Debug</__UniversalDevKitExpectedConsumerRuntime>
      <__UniversalDevKitExpectedConsumerRuntime Condition="'$(__UniversalDevKitSelectedRuntime)' == 'Dynamic'">$(__UniversalDevKitExpectedConsumerRuntime)DLL</__UniversalDevKitExpectedConsumerRuntime>
    </PropertyGroup>
    <Error Condition="'@(__UniversalDevKitBinaryReference)' != '' and '$(__UniversalDevKitConsumerRuntimeLibrary)' != '$(__UniversalDevKitExpectedConsumerRuntime)'"
           Text="Consumer CRT debug/release variant does not match the UniversalDevKit configuration." />
    <PropertyGroup>
      <__UniversalDevKitRuntimeBuildProperties>Configuration=$(Configuration);Platform=$(Platform)</__UniversalDevKitRuntimeBuildProperties>
      <__UniversalDevKitRuntimeBuildProperties Condition="'@(__UniversalDevKitBinaryReference)' != ''">$(__UniversalDevKitRuntimeBuildProperties);UniversalDevKitRuntime=$(__UniversalDevKitSelectedRuntime);PlatformToolset=$(PlatformToolset);VCToolsVersion=$(VCToolsVersion)</__UniversalDevKitRuntimeBuildProperties>
      <!-- The solution has one CRT per project. Consumers build the other variants. -->
      <BuildProjectReferences Condition="'@(__UniversalDevKitBinaryReference)' != ''">true</BuildProjectReferences>
    </PropertyGroup>
  </Target>
  <!-- VC also uses SetConfiguration to obtain link libraries.
       Extend it after assigning configurations and before splitting references. -->
  <Target Name="__UniversalDevKitConfigureReferenceContext"
          AfterTargets="AssignProjectConfiguration"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(__UniversalDevKitBinaryReference)' != ''">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Condition="$([System.String]::Copy('%(ProjectReferenceWithConfiguration.Filename)').StartsWith('UniversalDevKit.'))">
        <BuildReference>true</BuildReference>
        <SetConfiguration>%(ProjectReferenceWithConfiguration.SetConfiguration);UniversalDevKitRuntime=$(__UniversalDevKitSelectedRuntime);PlatformToolset=$(PlatformToolset);VCToolsVersion=$(VCToolsVersion)</SetConfiguration>
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>
  <!-- Recompute references and runtime files when the component registry changes. -->
  <Target Name="__UniversalDevKitValidateComponentRegistry"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '@(__UniversalDevKitComponentRegistryFile)' != ''">
    <GetFileHash Files="@(__UniversalDevKitComponentRegistryFile)"
                 Algorithm="SHA256">
      <Output TaskParameter="Items"
              ItemName="__UniversalDevKitComponentRegistryHash" />
    </GetFileHash>
    <Error Condition="'%(__UniversalDevKitComponentRegistryHash.FileHash)' != '%(__UniversalDevKitComponentRegistryHash.ExpectedHash)'"
           Text="UniversalDevKit component registry changed: %(__UniversalDevKitComponentRegistryHash.Identity). Update the connection using Connect." />
  </Target>
  <!-- Read the actual TargetPath of every transitive DLL after a successful build. -->
  <Target Name="__UniversalDevKitCopyDynamicLibraries"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and ('@(__UniversalDevKitRuntimeProject)' != '' or Exists('$(OutDir).UniversalDevKitRuntime'))">
    <ItemGroup>
      <__UniversalDevKitRuntimeFile Remove="@(__UniversalDevKitRuntimeFile)" />
    </ItemGroup>
    <MSBuild Projects="@(__UniversalDevKitRuntimeProject)"
             Condition="'@(__UniversalDevKitRuntimeProject)' != ''"
             Targets="GetTargetPath"
             Properties="$(__UniversalDevKitRuntimeBuildProperties)"
             BuildInParallel="true">
      <Output TaskParameter="TargetOutputs"
              ItemName="__UniversalDevKitRuntimeFile" />
    </MSBuild>
    <PropertyGroup>
      <__UniversalDevKitRuntimeSources>$(IntDir)UniversalDevKit.RuntimeSources.txt</__UniversalDevKitRuntimeSources>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(__UniversalDevKitRuntimeSources)" Lines="@(__UniversalDevKitRuntimeFile)" Overwrite="true" Encoding="UTF-8" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\Scripts\PowerShell\SyncRuntimeLibraries.ps1&quot; -OutputDirectory &quot;$(OutDir).&quot; -Owner &quot;$(MSBuildProjectFullPath)|$(Configuration)|$(Platform)&quot; -SourceList &quot;$(__UniversalDevKitRuntimeSources)&quot;" />
  </Target>
</Project>