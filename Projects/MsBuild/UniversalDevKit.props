<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Подключается явно через Import: добавляет Includes и доступные метаданные версии.
       Сохраняет include-пути потребителя; не подключает исходники или библиотеки
       и не меняет стандарт C++, CRT или каталоги сборки. -->
  <Import Project="$(MSBuildThisFileDirectory)UniversalDevKit.Version.props"
          Condition="Exists('$(MSBuildThisFileDirectory)UniversalDevKit.Version.props')" />

  <PropertyGroup>
    <!-- Импортирующие файлы проверяют этот признак, чтобы избежать повторного импорта. -->
    <__IsUniversalDevKitPublicPropsImported>true</__IsUniversalDevKitPublicPropsImported>
    <UniversalDevKitTargetOS Condition="'$(UniversalDevKitTargetOS)' == ''">Windows</UniversalDevKitTargetOS>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Корень Includes позволяет писать #include <UniversalDevKit/Helpers/Math.h>.
           Существующие include-пути проекта сохраняются через наследуемое значение. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\Includes;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>