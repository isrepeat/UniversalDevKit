<Window x:Class="UniversalDevKit.UdkCli.Setup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall UDK CLI"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Remove UDK CLI for the current user?" />
        <CheckBox x:Name="RemoveVersionCacheCheckBox"
                  Content="Удалить также кеш версий UDK"
                  IsChecked="False"
                  Margin="0,16,0,18" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Uninstall"
                    MinWidth="100"
                    Padding="10,5"
                    Click="OnUninstallClick" />
            <Button Content="Cancel"
                    IsCancel="True"
                    IsDefault="True"
                    MinWidth="100"
                    Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>