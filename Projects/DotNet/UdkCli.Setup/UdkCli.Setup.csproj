<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UdkPayload)' != ''">
    <EmbeddedResource Include="$(UdkPayload)" LogicalName="UdkPayload.zip" />
  </ItemGroup>
  <Target Name="RequireUdkPayload" BeforeTargets="Publish" Condition="'$(UdkPayload)' == ''">
    <Error Text="Build the UDK CLI setup through Publish.UdkCli.cmd." />
  </Target>
</Project>