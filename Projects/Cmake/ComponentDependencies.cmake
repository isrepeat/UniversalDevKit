# JSON задаёт исходники и зависимости; файлы компонентов расширяют системные настройки.
file(READ "${PROJECT_SOURCE_DIR}/Components.json" registryManifest)
string(JSON registryEntryCount LENGTH "${registryManifest}" "includes")
if(registryEntryCount LESS 1)
    message(FATAL_ERROR "Empty component registry")
endif()
math(EXPR registryEntryLastIndex "${registryEntryCount} - 1")
set(registeredComponentNames)
foreach(registryEntryIndex RANGE ${registryEntryLastIndex})
    string(JSON componentRegistryEntryPath GET "${registryManifest}" "includes" ${registryEntryIndex})
    file(READ "${PROJECT_SOURCE_DIR}/${componentRegistryEntryPath}" componentDefinitionJson)
    string(JSON componentName GET "${componentDefinitionJson}" "name")
    if(NOT componentName MATCHES "^[A-Z][A-Za-z0-9]*$" OR componentName IN_LIST registeredComponentNames)
        message(FATAL_ERROR "Invalid or duplicate component: ${componentName}")
    endif()
    list(APPEND registeredComponentNames "${componentName}")
    set(componentDefinitionJson_${componentName} "${componentDefinitionJson}")
    string(JSON componentStateScope ERROR_VARIABLE stateScopeJsonError GET "${componentDefinitionJson}" "stateScope")
    if(stateScopeJsonError)
        set(componentStateScope "module")
    elseif(NOT componentStateScope MATCHES "^(module|process)$")
        message(FATAL_ERROR "Invalid stateScope for ${componentName}: ${componentStateScope}")
    endif()
    set(componentStateScope_${componentName} "${componentStateScope}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${componentRegistryEntryPath}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/Components.json")

# Варианты зависимостей включаются независимо от выбора вариантов корней.
function(udkRequireComponentVariant componentName componentVariant dependencyTraversalChain)
    if(NOT componentName IN_LIST registeredComponentNames)
        message(FATAL_ERROR "Unknown component: ${componentName}")
    endif()
    if(componentName IN_LIST dependencyTraversalChain)
        message(FATAL_ERROR "Dependency cycle: ${dependencyTraversalChain};${componentName}")
    endif()
    if(componentStateScope_${componentName} STREQUAL "process" AND NOT componentVariant STREQUAL "Dynamic")
        message(FATAL_ERROR "Component ${componentName} has process state and requires Dynamic linkage")
    endif()
    string(JSON supportedPlatformCount ERROR_VARIABLE supportedPlatformsJsonError LENGTH "${componentDefinitionJson_${componentName}}" "supportedPlatforms")
    if(NOT supportedPlatformsJsonError)
        set(componentSupportedPlatforms)
        if(supportedPlatformCount GREATER 0)
            math(EXPR supportedPlatformLastIndex "${supportedPlatformCount} - 1")
            foreach(supportedPlatformIndex RANGE ${supportedPlatformLastIndex})
                string(JSON supportedPlatformName GET "${componentDefinitionJson_${componentName}}" "supportedPlatforms" ${supportedPlatformIndex})
                list(APPEND componentSupportedPlatforms "${supportedPlatformName}")
            endforeach()
        endif()
        if(NOT CMAKE_SYSTEM_NAME IN_LIST componentSupportedPlatforms)
            message(FATAL_ERROR "Unsupported platform for ${componentName}: ${CMAKE_SYSTEM_NAME}")
        endif()
    endif()
    get_property(componentVariantRequired GLOBAL PROPERTY "udkRequiredVariant_${componentName}_${componentVariant}")
    if(componentVariantRequired)
        return()
    endif()
    set_property(GLOBAL PROPERTY "udkRequiredVariant_${componentName}_${componentVariant}" TRUE)
    list(APPEND dependencyTraversalChain "${componentName}")
    string(JSON dependencyCount LENGTH "${componentDefinitionJson_${componentName}}" "dependencies")
    if(dependencyCount GREATER 0)
        math(EXPR dependencyLastIndex "${dependencyCount} - 1")
        foreach(dependencyIndex RANGE ${dependencyLastIndex})
            string(JSON dependencyComponentName GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "component")
            string(JSON dependencyLinkage GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "linkage")
            string(JSON dependencyVisibility GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "visibility")
            if(NOT dependencyLinkage MATCHES "^(same|static|dynamic)$" OR NOT dependencyVisibility MATCHES "^(private|public)$")
                message(FATAL_ERROR "Invalid dependency contract: ${componentName}")
            endif()
            set(dependencyVariant "${componentVariant}")
            if(dependencyLinkage STREQUAL "static")
                set(dependencyVariant Static)
            elseif(dependencyLinkage STREQUAL "dynamic")
                set(dependencyVariant Dynamic)
            endif()
            udkRequireComponentVariant("${dependencyComponentName}" "${dependencyVariant}" "${dependencyTraversalChain}")
        endforeach()
    endif()
endfunction()
foreach(componentName IN LISTS registeredComponentNames)
    foreach(componentVariant IN ITEMS Static Dynamic)
        set_property(GLOBAL PROPERTY "udkRequiredVariant_${componentName}_${componentVariant}" FALSE)
    endforeach()
endforeach()
set(requestedComponentNames "${UniversalDevKit_COMPONENTS}")
if(requestedComponentNames STREQUAL "ALL")
    set(requestedComponentNames "${registeredComponentNames}")
endif()
foreach(componentName IN LISTS requestedComponentNames)
    if(NOT componentName IN_LIST registeredComponentNames)
        message(FATAL_ERROR "Unknown requested component: ${componentName}")
    endif()
    if(componentStateScope_${componentName} STREQUAL "process" AND NOT UniversalDevKit_BUILD_DYNAMIC AND UniversalDevKit_BUILD_STATIC)
        message(FATAL_ERROR "Requested process-state component ${componentName} requires UniversalDevKit_BUILD_DYNAMIC")
    endif()
    if(UniversalDevKit_BUILD_STATIC AND NOT componentStateScope_${componentName} STREQUAL "process")
        udkRequireComponentVariant("${componentName}" Static "")
    endif()
    if(UniversalDevKit_BUILD_DYNAMIC)
        udkRequireComponentVariant("${componentName}" Dynamic "")
    endif()
endforeach()
set(exportedComponentTargets)
set(availablePackageComponents)
set(packageDependencyCommands "")
foreach(componentName IN LISTS registeredComponentNames)
    string(TOLOWER "${componentName}" componentNameLower)
    string(TOUPPER "${componentName}" componentNameUpper)
    set(currentComponentTargets)
    foreach(componentVariant IN ITEMS Static Dynamic)
        get_property(componentVariantRequired GLOBAL PROPERTY "udkRequiredVariant_${componentName}_${componentVariant}")
        if(NOT componentVariantRequired)
            continue()
        endif()
        set(componentTargetName "universaldevkit_${componentNameLower}")
        set(cmakeLibraryType STATIC)
        if(componentVariant STREQUAL "Dynamic")
            string(APPEND componentTargetName "_dynamic")
            set(cmakeLibraryType SHARED)
        endif()
        set(componentFilePaths)
        foreach(componentFileListKey IN ITEMS sources headers)
            string(JSON componentFileCount LENGTH "${componentDefinitionJson_${componentName}}" "${componentFileListKey}")
            if(componentFileCount GREATER 0)
                math(EXPR componentFileLastIndex "${componentFileCount} - 1")
                foreach(componentFileIndex RANGE ${componentFileLastIndex})
                    string(JSON componentFilePath GET "${componentDefinitionJson_${componentName}}" "${componentFileListKey}" ${componentFileIndex})
                    if(IS_ABSOLUTE "${componentFilePath}" OR componentFilePath MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${componentFilePath}")
                        message(FATAL_ERROR "Invalid component file: ${componentFilePath}")
                    endif()
                    list(APPEND componentFilePaths "${PROJECT_SOURCE_DIR}/${componentFilePath}")
                endforeach()
            endif()
        endforeach()
        string(JSON platformSourceCount ERROR_VARIABLE platformSourcesJsonError LENGTH "${componentDefinitionJson_${componentName}}" "platformSources" "${CMAKE_SYSTEM_NAME}")
        if(NOT platformSourcesJsonError AND platformSourceCount GREATER 0)
            math(EXPR platformSourceLastIndex "${platformSourceCount} - 1")
            foreach(platformSourceIndex RANGE ${platformSourceLastIndex})
                string(JSON platformSourcePath GET "${componentDefinitionJson_${componentName}}" "platformSources" "${CMAKE_SYSTEM_NAME}" ${platformSourceIndex})
                if(IS_ABSOLUTE "${platformSourcePath}" OR platformSourcePath MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${platformSourcePath}")
                    message(FATAL_ERROR "Invalid platform source: ${platformSourcePath}")
                endif()
                list(APPEND componentFilePaths "${PROJECT_SOURCE_DIR}/${platformSourcePath}")
            endforeach()
        endif()
        add_library(${componentTargetName} ${cmakeLibraryType} ${componentFilePaths})
        add_library(UniversalDevKit::${componentName}.${componentVariant} ALIAS ${componentTargetName})
        target_link_libraries(${componentTargetName} PUBLIC UniversalDevKit::Headers)
        set_target_properties(${componentTargetName} PROPERTIES EXPORT_NAME ${componentName}.${componentVariant} POSITION_INDEPENDENT_CODE ON DEBUG_POSTFIX d)
        if(componentVariant STREQUAL "Dynamic")
            target_compile_definitions(${componentTargetName} PUBLIC UNIVERSALDEVKIT_${componentNameUpper}_DYNAMIC PRIVATE UNIVERSALDEVKIT_${componentNameUpper}_EXPORTS)
        endif()
        list(APPEND currentComponentTargets "${componentTargetName}")
        list(APPEND exportedComponentTargets "${componentTargetName}")
    endforeach()
    if(currentComponentTargets)
        list(APPEND availablePackageComponents "${componentName}")
        if(EXISTS "${PROJECT_SOURCE_DIR}/Projects/Cmake/${componentName}/CMakeLists.txt")
            include("${PROJECT_SOURCE_DIR}/Projects/Cmake/${componentName}/CMakeLists.txt")
        endif()
    endif()
endforeach()
# Связываем после создания всех targets, независимо от порядка реестра.
foreach(componentName IN LISTS availablePackageComponents)
    string(TOLOWER "${componentName}" componentNameLower)
    string(JSON dependencyCount LENGTH "${componentDefinitionJson_${componentName}}" "dependencies")
    if(dependencyCount EQUAL 0)
        continue()
    endif()
    math(EXPR dependencyLastIndex "${dependencyCount} - 1")
    foreach(dependencyIndex RANGE ${dependencyLastIndex})
        string(JSON dependencyComponentName GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "component")
        string(JSON dependencyLinkage GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "linkage")
        string(JSON dependencyVisibility GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "visibility")
        string(TOUPPER "${dependencyVisibility}" dependencyVisibility)
        foreach(componentVariant IN ITEMS Static Dynamic)
            set(componentTargetName "universaldevkit_${componentNameLower}")
            if(componentVariant STREQUAL "Dynamic")
                string(APPEND componentTargetName "_dynamic")
            endif()
            if(TARGET ${componentTargetName})
                set(dependencyVariant "${componentVariant}")
                if(dependencyLinkage STREQUAL "static")
                    set(dependencyVariant Static)
                elseif(dependencyLinkage STREQUAL "dynamic")
                    set(dependencyVariant Dynamic)
                endif()
                target_link_libraries(${componentTargetName} ${dependencyVisibility} UniversalDevKit::${dependencyComponentName}.${dependencyVariant})
            endif()
        endforeach()
    endforeach()
endforeach()

# Передаём требования вариантов всего графа, включая внутренние зависимости DLL.
# CMake проверяет их совместимость для каждого consumer при генерации сборки.
function(udkCollectVariantRequirements componentName componentVariant)
    set(componentVariantKey "${componentName}.${componentVariant}")
    get_property(visitedVariantRequirements GLOBAL PROPERTY udkVisitedVariantRequirements)
    if(componentVariantKey IN_LIST visitedVariantRequirements)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY udkVisitedVariantRequirements "${componentVariantKey}")
    set_property(GLOBAL APPEND PROPERTY "udkVariantValues_${componentName}" "${componentVariant}")
    string(JSON dependencyCount LENGTH "${componentDefinitionJson_${componentName}}" "dependencies")
    if(dependencyCount GREATER 0)
        math(EXPR dependencyLastIndex "${dependencyCount} - 1")
        foreach(dependencyIndex RANGE ${dependencyLastIndex})
            string(JSON dependencyComponentName GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "component")
            string(JSON dependencyLinkage GET "${componentDefinitionJson_${componentName}}" "dependencies" ${dependencyIndex} "linkage")
            set(dependencyVariant "${componentVariant}")
            if(dependencyLinkage STREQUAL "static")
                set(dependencyVariant Static)
            elseif(dependencyLinkage STREQUAL "dynamic")
                set(dependencyVariant Dynamic)
            endif()
            udkCollectVariantRequirements("${dependencyComponentName}" "${dependencyVariant}")
        endforeach()
    endif()
endfunction()

foreach(componentName IN LISTS availablePackageComponents)
    string(TOLOWER "${componentName}" componentNameLower)
    foreach(componentVariant IN ITEMS Static Dynamic)
        set(componentTargetName "universaldevkit_${componentNameLower}")
        if(componentVariant STREQUAL "Dynamic")
            string(APPEND componentTargetName "_dynamic")
        endif()
        if(NOT TARGET ${componentTargetName})
            continue()
        endif()
        set_property(GLOBAL PROPERTY udkVisitedVariantRequirements "")
        foreach(registeredComponentName IN LISTS registeredComponentNames)
            set_property(GLOBAL PROPERTY "udkVariantValues_${registeredComponentName}" "")
        endforeach()
        udkCollectVariantRequirements("${componentName}" "${componentVariant}")
        foreach(registeredComponentName IN LISTS registeredComponentNames)
            get_property(componentRequiredVariants GLOBAL PROPERTY "udkVariantValues_${registeredComponentName}")
            list(REMOVE_DUPLICATES componentRequiredVariants)
            list(LENGTH componentRequiredVariants componentRequiredVariantCount)
            if(componentRequiredVariantCount GREATER 1)
                message(FATAL_ERROR "Conflicting linkage for ${registeredComponentName} in ${componentName}.${componentVariant}")
            endif()
            if(componentRequiredVariantCount EQUAL 1)
                set(componentCompatibilityKey "UDK_COMPONENT_VARIANT_${registeredComponentName}")
                set_property(TARGET ${componentTargetName} PROPERTY "INTERFACE_${componentCompatibilityKey}" "${componentRequiredVariants}")
                set_property(TARGET ${componentTargetName} APPEND PROPERTY COMPATIBLE_INTERFACE_STRING "${componentCompatibilityKey}")
            endif()
        endforeach()
    endforeach()
endforeach()