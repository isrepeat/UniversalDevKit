# Создаём все targets до связывания: порядок includes не задаёт порядок зависимостей.
file(READ "${PROJECT_SOURCE_DIR}/Components.json" universaldevkit_manifest)
string(JSON universaldevkit_count LENGTH "${universaldevkit_manifest}" includes)
math(EXPR universaldevkit_last "${universaldevkit_count} - 1")
set(universaldevkit_descriptions)
foreach(index RANGE ${universaldevkit_last})
    string(JSON description_path GET "${universaldevkit_manifest}" includes ${index})
    file(READ "${PROJECT_SOURCE_DIR}/${description_path}" description)
    string(JSON component GET "${description}" name)
    list(APPEND universaldevkit_descriptions "${description_path}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${description_path}")
    add_subdirectory("${PROJECT_SOURCE_DIR}/Projects/Cmake/${component}" "Projects/Cmake/${component}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/Components.json")

# JSON определяет видимость и вариант каждой межкомпонентной зависимости.
foreach(description_path IN LISTS universaldevkit_descriptions)
    file(READ "${PROJECT_SOURCE_DIR}/${description_path}" description)
    string(JSON component GET "${description}" name)
    string(TOLOWER "${component}" component_lower)
    string(JSON dependency_count ERROR_VARIABLE dependency_error LENGTH "${description}" dependencies)
    if(dependency_error OR dependency_count EQUAL 0)
        continue()
    endif()
    math(EXPR dependency_last "${dependency_count} - 1")
    foreach(index RANGE ${dependency_last})
        string(JSON dependency GET "${description}" dependencies ${index} component)
        string(JSON visibility GET "${description}" dependencies ${index} visibility)
        string(JSON linkage GET "${description}" dependencies ${index} linkage)
        string(TOUPPER "${visibility}" visibility)
        if(NOT visibility MATCHES "^(PRIVATE|PUBLIC)$" OR NOT linkage MATCHES "^(same|static)$")
            message(FATAL_ERROR "Invalid dependency contract for ${component}: ${dependency}")
        endif()
        foreach(mode IN ITEMS Static Dynamic)
            set(target "universaldevkit_${component_lower}")
            if(mode STREQUAL "Dynamic")
                string(APPEND target "_dynamic")
            endif()
            set(dependency_mode "${mode}")
            if(linkage STREQUAL "static")
                set(dependency_mode Static)
            endif()
            if(NOT TARGET UniversalDevKit::${dependency}.${dependency_mode})
                message(FATAL_ERROR "Unknown dependency for ${component}: ${dependency}.${dependency_mode}")
            endif()
            target_link_libraries(${target} ${visibility} UniversalDevKit::${dependency}.${dependency_mode})
        endforeach()
    endforeach()
endforeach()