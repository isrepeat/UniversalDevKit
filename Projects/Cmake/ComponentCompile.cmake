# Проверяем общие настройки компиляции независимо от происхождения исходников.
function(udkReadCompile settings)
    udkCheckObjectKeys("${settings}" "includeDirectories;preprocessorDefinitions;precompiledHeader" compile)
    set(includes)
    set(definitions)
    set(pch "")
    foreach(field IN ITEMS includeDirectories preprocessorDefinitions)
        string(JSON type ERROR_VARIABLE missing TYPE "${settings}" ${field})
        if(missing)
            continue()
        endif()
        if(NOT type STREQUAL "ARRAY")
            message(FATAL_ERROR "compile.${field} must be an array")
        endif()
        string(JSON count LENGTH "${settings}" ${field})
        set(seen)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON type TYPE "${settings}" ${field} ${index})
                string(JSON value GET "${settings}" ${field} ${index})
                if(NOT type STREQUAL "STRING" OR value IN_LIST seen)
                    message(FATAL_ERROR "Invalid or duplicate compile.${field} entry")
                endif()
                list(APPEND seen "${value}")
                if(field STREQUAL "includeDirectories")
                    udkCheckRegistryPath("${value}")
                    if(value STREQUAL "" OR NOT IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${value}")
                        message(FATAL_ERROR "Missing include directory: ${value}")
                    endif()
                    list(APPEND includes "${PROJECT_SOURCE_DIR}/${value}")
                else()
                    if(NOT value MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=[^;\r\n$@%<>]*)?$")
                        message(FATAL_ERROR "Invalid preprocessor definition: ${value}")
                    endif()
                    list(APPEND definitions "${value}")
                endif()
            endforeach()
        endif()
    endforeach()
    string(JSON pch ERROR_VARIABLE missing GET "${settings}" precompiledHeader)
    if(missing)
        set(pch "")
    elseif(NOT pch MATCHES "^(inherit|notUsing)$")
        message(FATAL_ERROR "Invalid precompiledHeader")
    endif()
    set(compileIncludes "${includes}" PARENT_SCOPE)
    set(compileDefinitions "${definitions}" PARENT_SCOPE)
    set(compilePch "${pch}" PARENT_SCOPE)
endfunction()

function(udkCheckComponentCompile json)
    string(JSON settings ERROR_VARIABLE missing GET "${json}" compile)
    string(JSON kind ERROR_VARIABLE noKind GET "${json}" kind)
    if(NOT missing)
        if(kind STREQUAL "headerOnly")
            message(FATAL_ERROR "Header-only component cannot contain compile settings")
        endif()
        udkReadCompile("${settings}")
    endif()
    set(files)
    set(sources)
    foreach(field IN ITEMS sources headers)
        string(JSON count LENGTH "${json}" ${field})
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON path GET "${json}" ${field} ${index})
                string(TOLOWER "${path}" folded)
                if(folded IN_LIST files)
                    message(FATAL_ERROR "Duplicate component file: ${path}")
                endif()
                list(APPEND files "${folded}")
                if(field STREQUAL "sources")
                    list(APPEND sources "${path}")
                endif()
            endforeach()
        endif()
    endforeach()
    string(JSON platforms ERROR_VARIABLE missing LENGTH "${json}" platformSources)
    if(NOT missing AND platforms GREATER 0)
        math(EXPR lastPlatform "${platforms} - 1")
        foreach(platformIndex RANGE ${lastPlatform})
            string(JSON platform MEMBER "${json}" platformSources ${platformIndex})
            string(JSON count LENGTH "${json}" platformSources ${platform})
            if(count GREATER 0)
                math(EXPR last "${count} - 1")
                foreach(index RANGE ${last})
                    string(JSON path GET "${json}" platformSources ${platform} ${index})
                    list(APPEND sources "${path}")
                endforeach()
            endif()
        endforeach()
    endif()
    string(JSON type ERROR_VARIABLE missing TYPE "${json}" sourceSettings)
    if(missing)
        return()
    endif()
    if(NOT type STREQUAL "ARRAY" OR kind STREQUAL "headerOnly")
        message(FATAL_ERROR "sourceSettings requires an array on a compiled component")
    endif()
    string(JSON count LENGTH "${json}" sourceSettings)
    set(seen)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON entry GET "${json}" sourceSettings ${index})
            udkCheckObjectKeys("${entry}" "files;compile" sourceSettings)
            string(JSON settings GET "${entry}" compile)
            udkReadCompile("${settings}")
            string(JSON type TYPE "${entry}" files)
            string(JSON fileCount LENGTH "${entry}" files)
            if(NOT type STREQUAL "ARRAY" OR fileCount LESS 1)
                message(FATAL_ERROR "sourceSettings.files must be a nonempty array")
            endif()
            math(EXPR fileLast "${fileCount} - 1")
            foreach(fileIndex RANGE ${fileLast})
                string(JSON type TYPE "${entry}" files ${fileIndex})
                string(JSON path GET "${entry}" files ${fileIndex})
                string(TOLOWER "${path}" folded)
                if(NOT type STREQUAL "STRING" OR NOT path IN_LIST sources OR folded IN_LIST seen)
                    message(FATAL_ERROR "Unknown or duplicate sourceSettings file: ${path}")
                endif()
                list(APPEND seen "${folded}")
            endforeach()
        endforeach()
    endif()
endfunction()

function(udkApplyComponentCompile target json)
    string(JSON settings ERROR_VARIABLE missing GET "${json}" compile)
    if(missing)
        set(settings "{}")
    endif()
    udkReadCompile("${settings}")
    if(compileIncludes)
        target_include_directories(${target} PRIVATE ${compileIncludes})
    endif()
    if(compileDefinitions)
        target_compile_definitions(${target} PRIVATE ${compileDefinitions})
    endif()
    # По умолчанию исходники компонента наследуют настройки PCH сборки.
    get_target_property(paths ${target} SOURCES)
    foreach(path IN LISTS paths)
        if(path MATCHES "\\.cpp$")
            set(skipPch OFF)
            if(compilePch STREQUAL "notUsing")
                set(skipPch ON)
            endif()
            set_property(SOURCE "${path}" TARGET_DIRECTORY ${target} PROPERTY SKIP_PRECOMPILE_HEADERS ${skipPch})
        endif()
    endforeach()
    string(JSON count ERROR_VARIABLE missing LENGTH "${json}" sourceSettings)
    if(NOT missing AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON entry GET "${json}" sourceSettings ${index})
            string(JSON settings GET "${entry}" compile)
            udkReadCompile("${settings}")
            string(JSON fileCount LENGTH "${entry}" files)
            math(EXPR fileLast "${fileCount} - 1")
            foreach(fileIndex RANGE ${fileLast})
                string(JSON relative GET "${entry}" files ${fileIndex})
                set(path "${PROJECT_SOURCE_DIR}/${relative}")
                if(NOT path IN_LIST paths)
                    continue()
                endif()
                if(compileIncludes)
                    set_property(SOURCE "${path}" TARGET_DIRECTORY ${target} PROPERTY INCLUDE_DIRECTORIES "${compileIncludes}")
                endif()
                if(compileDefinitions)
                    set_property(SOURCE "${path}" TARGET_DIRECTORY ${target} PROPERTY COMPILE_DEFINITIONS "${compileDefinitions}")
                endif()
                if(compilePch STREQUAL "notUsing")
                    set_property(SOURCE "${path}" TARGET_DIRECTORY ${target} PROPERTY SKIP_PRECOMPILE_HEADERS ON)
                elseif(compilePch STREQUAL "inherit")
                    set_property(SOURCE "${path}" TARGET_DIRECTORY ${target} PROPERTY SKIP_PRECOMPILE_HEADERS OFF)
                endif()
            endforeach()
        endforeach()
    endif()
endfunction()