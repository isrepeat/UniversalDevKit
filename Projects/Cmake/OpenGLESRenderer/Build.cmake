function(udk_extend_OpenGLESRenderer target variant outputRoot)
    if(NOT TARGET XamlRuntime::OpenGLESRenderer)
        add_library(XamlRuntime::OpenGLESRenderer ALIAS ${target})
    endif()
    if(ANDROID)
        target_link_libraries(${target} PRIVATE GLESv3)
    elseif(WIN32)
        set(UniversalDevKitAngleRoot "$ENV{UDK_ANGLE_ROOT}" CACHE PATH "ANGLE installation or extracted legacy XamlRuntime package")
        find_path(udkAngleInclude GLES3/gl3.h PATHS "${UniversalDevKitAngleRoot}/include" "${UniversalDevKitAngleRoot}/build/native/include" NO_DEFAULT_PATH REQUIRED)
        target_include_directories(${target} SYSTEM PRIVATE "${udkAngleInclude}")
        foreach(library EGL GLESv2)
            find_library(udkAngle${library} NAMES lib${library} PATHS "${UniversalDevKitAngleRoot}/lib" "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/Release" NO_DEFAULT_PATH REQUIRED)
            target_link_libraries(${target} PRIVATE "$<BUILD_INTERFACE:${udkAngle${library}}>")
        endforeach()
        if(NOT TARGET UniversalDevKit::ANGLE)
            add_library(UniversalDevKit::ANGLE INTERFACE IMPORTED GLOBAL)
            set_target_properties(UniversalDevKit::ANGLE PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${udkAngleInclude}"
                INTERFACE_LINK_LIBRARIES "${udkAngleEGL};${udkAngleGLESv2}")
        endif()
        target_link_libraries(${target} PRIVATE "$<INSTALL_INTERFACE:UniversalDevKit::ANGLE>")
        get_property(angleInstallRegistered GLOBAL PROPERTY udkAngleInstallRegistered)
        if(UniversalDevKit_INSTALL AND NOT angleInstallRegistered)
            set_property(GLOBAL PROPERTY udkAngleInstallRegistered TRUE)
            install(DIRECTORY "${udkAngleInclude}/" DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/ANGLE")
            foreach(configuration Debug Release)
                if(EXISTS "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/${configuration}")
                    set(angleBin "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/${configuration}")
                    set(angleLib "${angleBin}")
                else()
                    set(angleBin "${UniversalDevKitAngleRoot}/bin")
                    set(angleLib "${UniversalDevKitAngleRoot}/lib")
                    if(configuration STREQUAL "Debug" AND EXISTS "${UniversalDevKitAngleRoot}/debug/bin")
                        set(angleBin "${UniversalDevKitAngleRoot}/debug/bin")
                        set(angleLib "${UniversalDevKitAngleRoot}/debug/lib")
                    endif()
                endif()
                foreach(library libEGL libGLESv2)
                    install(FILES "${angleLib}/${library}.lib" DESTINATION "${CMAKE_INSTALL_LIBDIR}/ANGLE/${configuration}" CONFIGURATIONS ${configuration})
                    install(FILES "${angleBin}/${library}.dll" DESTINATION "${CMAKE_INSTALL_BINDIR}/ANGLE/${configuration}" CONFIGURATIONS ${configuration})
                endforeach()
                foreach(library z.dll zd.dll)
                    if(EXISTS "${angleBin}/${library}")
                        install(FILES "${angleBin}/${library}" DESTINATION "${CMAKE_INSTALL_BINDIR}/ANGLE/${configuration}" CONFIGURATIONS ${configuration})
                    endif()
                endforeach()
            endforeach()
            configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/AngleConfig.cmake.in" "${outputRoot}/UniversalDevKitAngle.cmake" @ONLY)
            install(FILES "${outputRoot}/UniversalDevKitAngle.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/UniversalDevKit")
        endif()
        target_compile_options(${target} PRIVATE /utf-8 /EHsc)
    endif()
endfunction()