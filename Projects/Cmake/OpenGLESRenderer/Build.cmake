function(udk_extend_OpenGLESRenderer target variant outputRoot)
    if(NOT TARGET XamlRuntime::OpenGLESRenderer)
        add_library(XamlRuntime::OpenGLESRenderer ALIAS ${target})
    endif()
    if(ANDROID)
        target_link_libraries(${target} PRIVATE GLESv3)
    elseif(WIN32)
        set(UniversalDevKitAngleRoot "$ENV{UDK_ANGLE_ROOT}" CACHE PATH "ANGLE installation or extracted legacy XamlRuntime package")
        find_path(udkAngleInclude GLES3/gl3.h PATHS "${UniversalDevKitAngleRoot}/include" "${UniversalDevKitAngleRoot}/build/native/include" NO_DEFAULT_PATH REQUIRED)
        target_include_directories(${target} SYSTEM PRIVATE "${udkAngleInclude}")
        foreach(library EGL GLESv2)
            find_library(udkAngle${library} NAMES lib${library} PATHS "${UniversalDevKitAngleRoot}/lib" "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/Release" NO_DEFAULT_PATH REQUIRED)
            target_link_libraries(${target} PRIVATE "${udkAngle${library}}")
        endforeach()
        target_compile_options(${target} PRIVATE /utf-8 /EHsc)
    endif()
endfunction()