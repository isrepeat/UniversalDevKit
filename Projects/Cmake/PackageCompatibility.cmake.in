# Сгенерировано PackageMetadata.cmake. Консервативная политика бинарного выпуска.
# Проверки читают тот же JSON-контракт, который используют пакетные адаптеры.
file(GLOB binaryRecords "${CMAKE_CURRENT_LIST_DIR}/UniversalDevKit.Build-*.json")
if(NOT binaryRecords)
    message(FATAL_ERROR "UniversalDevKit package binary metadata is missing")
endif()
list(GET binaryRecords 0 binaryRecordPath)
file(READ "${binaryRecordPath}" binaryRecord)
string(JSON binarySchema GET "${binaryRecord}" schemaVersion)
string(JSON binaryPolicy GET "${binaryRecord}" compatibilityPolicy)
if(NOT binarySchema EQUAL 1 OR NOT binaryPolicy STREQUAL "ExactCompilerV1")
    message(FATAL_ERROR "UniversalDevKit package binary metadata schema/policy is unsupported")
endif()
foreach(field IN ITEMS platform architecture pointerSize compilerId compilerVersion toolset)
    string(JSON binary_${field} GET "${binaryRecord}" "${field}")
endforeach()
if(NOT CMAKE_SYSTEM_NAME STREQUAL binary_platform OR NOT CMAKE_SIZEOF_VOID_P EQUAL binary_pointerSize)
    message(FATAL_ERROR "UniversalDevKit package platform/architecture mismatch")
endif()
set(consumerArchitecture "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(consumerArchitecture "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
string(TOLOWER "${consumerArchitecture}" consumerArchitecture)
if(consumerArchitecture MATCHES "^(amd64|x86_64|x64)$")
    set(consumerArchitecture x64)
elseif(consumerArchitecture MATCHES "^(aarch64|arm64)$")
    set(consumerArchitecture arm64)
elseif(consumerArchitecture MATCHES "^(i[3-6]86|x86)$")
    set(consumerArchitecture x86)
endif()
if(NOT consumerArchitecture STREQUAL binary_architecture)
    message(FATAL_ERROR "UniversalDevKit package architecture mismatch: requires ${binary_architecture}")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL binary_compilerId OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL binary_compilerVersion)
    message(FATAL_ERROR "UniversalDevKit package compiler mismatch: requires ${binary_compilerId} ${binary_compilerVersion}")
endif()
if(MSVC AND CMAKE_VS_PLATFORM_TOOLSET AND binary_toolset AND NOT CMAKE_VS_PLATFORM_TOOLSET STREQUAL binary_toolset)
    message(FATAL_ERROR "UniversalDevKit package toolset mismatch")
endif()
foreach(component IN ITEMS @availablePackageComponents@)
    foreach(variant IN ITEMS Static Dynamic)
        if(MSVC AND TARGET UniversalDevKit::${component}.${variant})
            # Принудительный include проверяет реальный CRT target, в том числе overrides.
            set_property(TARGET UniversalDevKit::${component}.${variant} APPEND PROPERTY INTERFACE_COMPILE_OPTIONS "/FI${CMAKE_CURRENT_LIST_DIR}/UniversalDevKit.Abi-$<CONFIG>.h")
        endif()
    endforeach()
endforeach()