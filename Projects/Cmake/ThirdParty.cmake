# Сторонние исходники и приватные настройки читаются из реестра компонента.
function(udkReadThirdParty json)
    set(paths)
    set(sources)
    set(includes)
    set(definitions)
    set(names)
    set(files)
    string(JSON count ERROR_VARIABLE missing LENGTH "${json}" thirdParty)
    if(NOT missing)
        string(JSON type TYPE "${json}" thirdParty)
        string(JSON kind ERROR_VARIABLE noKind GET "${json}" kind)
        if(NOT type STREQUAL "ARRAY" OR kind STREQUAL "headerOnly")
            message(FATAL_ERROR "thirdParty requires an array on a compiled component")
        endif()
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON entry GET "${json}" thirdParty ${index})
                udkCheckObjectKeys("${entry}" "name;root;sources;headers;includeDirectories;compileDefinitions" thirdParty)
                string(JSON name GET "${entry}" name)
                string(JSON root GET "${entry}" root)
                string(JSON nameType TYPE "${entry}" name)
                string(JSON rootType TYPE "${entry}" root)
                string(TOLOWER "${name}" foldedName)
                if(NOT nameType STREQUAL "STRING" OR NOT name MATCHES "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" OR foldedName IN_LIST names)
                    message(FATAL_ERROR "Invalid or duplicate thirdParty name")
                endif()
                list(APPEND names "${foldedName}")
                udkCheckRegistryPath("${root}")
                if(NOT rootType STREQUAL "STRING" OR NOT root MATCHES "^ThirdParty/.+" OR NOT IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${root}")
                    message(FATAL_ERROR "Invalid thirdParty root: ${root}")
                endif()
                foreach(field IN ITEMS sources headers includeDirectories compileDefinitions)
                    string(JSON type TYPE "${entry}" ${field})
                    if(NOT type STREQUAL "ARRAY")
                        message(FATAL_ERROR "thirdParty.${field} must be an array")
                    endif()
                    set(seen)
                    string(JSON itemCount LENGTH "${entry}" ${field})
                    if(itemCount GREATER 0)
                        math(EXPR itemLast "${itemCount} - 1")
                        foreach(itemIndex RANGE ${itemLast})
                            string(JSON value GET "${entry}" ${field} ${itemIndex})
                            string(JSON type TYPE "${entry}" ${field} ${itemIndex})
                            string(TOLOWER "${value}" folded)
                            if(NOT type STREQUAL "STRING" OR folded IN_LIST seen)
                                message(FATAL_ERROR "Invalid or duplicate thirdParty.${field} entry")
                            endif()
                            list(APPEND seen "${folded}")
                            if(field STREQUAL "compileDefinitions")
                                if(NOT value MATCHES "^[A-Za-z_][A-Za-z0-9_]*(=[^;\r\n$@%<>]*)?$")
                                    message(FATAL_ERROR "Invalid compile definition: ${value}")
                                endif()
                                list(APPEND definitions "${value}")
                                continue()
                            endif()
                            udkCheckRegistryPath("${value}")
                            if(value STREQUAL "")
                                message(FATAL_ERROR "Empty thirdParty path")
                            endif()
                            set(path "${PROJECT_SOURCE_DIR}/${root}/${value}")
                            if(field STREQUAL "includeDirectories")
                                if(NOT IS_DIRECTORY "${path}")
                                    message(FATAL_ERROR "Missing include directory: ${path}")
                                endif()
                                list(APPEND includes "${path}")
                            else()
                                string(TOLOWER "${path}" foldedPath)
                                if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR foldedPath IN_LIST files)
                                    message(FATAL_ERROR "Missing or duplicate thirdParty file: ${path}")
                                endif()
                                list(APPEND files "${foldedPath}")
                                list(APPEND paths "${path}")
                                if(field STREQUAL "sources")
                                    if(NOT value MATCHES "\\.cpp$")
                                        message(FATAL_ERROR "Expected .cpp source: ${path}")
                                    endif()
                                    list(APPEND sources "${path}")
                                endif()
                            endif()
                        endforeach()
                    endif()
                endforeach()
            endforeach()
        endif()
    endif()
    set(udkThirdPartyFiles "${paths}" PARENT_SCOPE)
    set(udkThirdPartySources "${sources}" PARENT_SCOPE)
    set(udkThirdPartyIncludes "${includes}" PARENT_SCOPE)
    set(udkThirdPartyDefinitions "${definitions}" PARENT_SCOPE)
endfunction()

function(udkApplyThirdParty target json)
    udkReadThirdParty("${json}")
    if(udkThirdPartyFiles)
        target_sources(${target} PRIVATE ${udkThirdPartyFiles})
        source_group(TREE "${PROJECT_SOURCE_DIR}" FILES ${udkThirdPartyFiles})
    endif()
    if(udkThirdPartyIncludes)
        target_include_directories(${target} SYSTEM PRIVATE ${udkThirdPartyIncludes})
    endif()
    if(udkThirdPartyDefinitions)
        target_compile_definitions(${target} PRIVATE ${udkThirdPartyDefinitions})
    endif()
    if(udkThirdPartySources)
        set_source_files_properties(${udkThirdPartySources} PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
    endif()
endfunction()