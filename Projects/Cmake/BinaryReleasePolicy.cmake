# Политика выпуска ограничивает поддерживаемые бинарники, а не экспериментальные сборки.
function(udkValidateBinaryRelease policyFile)
    file(READ "${policyFile}" policy)
    string(JSON schema GET "${policy}" schemaVersion)
    string(JSON compatibility GET "${policy}" compatibilityPolicy)
    if(NOT schema EQUAL 1 OR NOT compatibility STREQUAL "ExactCompilerV1")
        message(FATAL_ERROR "Unsupported UDK binary release policy")
    endif()
    string(JSON standardLibrary GET "${policy}" standardLibrary)
    string(JSON debugIterator GET "${policy}" iteratorDebugLevel Debug)
    string(JSON releaseIterator GET "${policy}" iteratorDebugLevel Release)
    if(NOT standardLibrary STREQUAL "MSVC STL" OR NOT debugIterator EQUAL 2 OR NOT releaseIterator EQUAL 0)
        message(FATAL_ERROR "Unsupported release STL ABI: expected MSVC STL, Debug=2, Release=0")
    endif()
    foreach(field IN ITEMS platforms architectures compilerIds compilerVersions toolsets runtimes configurations variants)
        string(JSON count LENGTH "${policy}" "${field}")
        if(count LESS 1)
            message(FATAL_ERROR "Empty binary release policy field: ${field}")
        endif()
        math(EXPR last "${count} - 1")
        set(allowed)
        foreach(index RANGE ${last})
            string(JSON value GET "${policy}" "${field}" ${index})
            list(APPEND allowed "${value}")
        endforeach()
        foreach(actual IN LISTS udkRelease_${field})
            if(NOT actual IN_LIST allowed)
                message(FATAL_ERROR "UDK release ${field} mismatch: expected [${allowed}], actual [${actual}]")
            endif()
        endforeach()
        if(NOT DEFINED udkRelease_${field} OR "${udkRelease_${field}}" STREQUAL "")
            message(FATAL_ERROR "UDK release ${field} is unknown")
        endif()
    endforeach()
endfunction()