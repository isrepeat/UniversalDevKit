function(udk_extend_Diagnostic target variant outputRoot)
    get_filename_component(spdlogRoot "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../ThirdParty/spdlog" ABSOLUTE)
    if(NOT EXISTS "${spdlogRoot}/include/spdlog/version.h")
        message(FATAL_ERROR "Initialize spdlog: git submodule update --init ThirdParty/spdlog")
    endif()
    target_include_directories(${target} SYSTEM PRIVATE "${spdlogRoot}/include")
    target_compile_definitions(${target} PRIVATE SPDLOG_COMPILED_LIB)
    if(WIN32)
        target_compile_definitions(${target} PRIVATE SPDLOG_WCHAR_FILENAMES)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /utf-8)
    endif()
    foreach(source spdlog stdout_sinks color_sinks file_sinks async cfg bundled_fmtlib_format)
        target_sources(${target} PRIVATE "${spdlogRoot}/src/${source}.cpp")
    endforeach()
endfunction()