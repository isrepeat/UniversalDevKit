# Единый контракт выпуска не зависит от способа доставки бинарников.
function(udkJsonString output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

foreach(packageDirectory IN ITEMS CMAKE_INSTALL_LIBDIR CMAKE_INSTALL_BINDIR)
    if(IS_ABSOLUTE "${${packageDirectory}}" OR "${${packageDirectory}}" MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "UniversalDevKit package directories must be relative to the install prefix")
    endif()
endforeach()

set(udkPackageArchitecture "${CMAKE_SYSTEM_PROCESSOR}")
if(CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
    set(udkPackageArchitecture "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
string(TOLOWER "${udkPackageArchitecture}" udkPackageArchitecture)
if(udkPackageArchitecture MATCHES "^(amd64|x86_64|x64)$")
    set(udkPackageArchitecture x64)
elseif(udkPackageArchitecture MATCHES "^(aarch64|arm64)$")
    set(udkPackageArchitecture arm64)
elseif(udkPackageArchitecture MATCHES "^(i[3-6]86|x86)$")
    set(udkPackageArchitecture x86)
endif()

set(udkPackageContract "{}")
set(UniversalDevKit_ENFORCE_RELEASE_POLICY OFF CACHE BOOL "Require the supported binary release matrix")
set(udkReleasePolicyId Experimental)
if(UniversalDevKit_ENFORCE_RELEASE_POLICY)
    set(hasReleaseBinaries FALSE)
    set(udkRelease_variants)
    foreach(target IN LISTS exportedComponentTargets)
        get_target_property(type ${target} TYPE)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            set(hasReleaseBinaries TRUE)
            if(type STREQUAL "STATIC_LIBRARY")
                list(APPEND udkRelease_variants Static)
            else()
                list(APPEND udkRelease_variants Dynamic)
            endif()
        endif()
    endforeach()
    if(hasReleaseBinaries)
        set(udkRelease_platforms "${CMAKE_SYSTEM_NAME}")
        set(udkRelease_architectures "${udkPackageArchitecture}")
        set(udkRelease_compilerIds "${CMAKE_CXX_COMPILER_ID}")
        set(udkRelease_compilerVersions "${CMAKE_CXX_COMPILER_VERSION}")
        set(udkRelease_toolsets "${CMAKE_VS_PLATFORM_TOOLSET}")
        if(NOT udkRelease_toolsets AND MSVC_TOOLSET_VERSION)
            set(udkRelease_toolsets "v${MSVC_TOOLSET_VERSION}")
        endif()
        set(udkRelease_runtimes "${UniversalDevKitRuntime}")
        set(udkRelease_configurations "${CMAKE_CONFIGURATION_TYPES}")
        if(NOT udkRelease_configurations)
            set(udkRelease_configurations "${CMAKE_BUILD_TYPE}")
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/BinaryReleasePolicy.cmake")
        set(releasePolicyPath "${PROJECT_SOURCE_DIR}/BinaryReleasePolicy.json")
        udkValidateBinaryRelease("${releasePolicyPath}")
        file(READ "${releasePolicyPath}" releasePolicy)
        string(JSON udkReleasePolicyId GET "${releasePolicy}" id)
        install(FILES "${releasePolicyPath}" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/UniversalDevKit")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${releasePolicyPath}")
    endif()
endif()
udkJsonString(quoted "${udkReleasePolicyId}")
string(JSON udkPackageContract SET "${udkPackageContract}" releasePolicy "${quoted}")
string(JSON udkPackageContract SET "${udkPackageContract}" schemaVersion 1)
string(JSON udkPackageContract SET "${udkPackageContract}" compatibilityPolicy "\"ExactCompilerV1\"")
string(JSON udkPackageContract SET "${udkPackageContract}" abiVersion "${udkAbiVersion}")
foreach(pair IN ITEMS "version;${udkReleaseVersion}" "platform;${CMAKE_SYSTEM_NAME}" "architecture;${udkPackageArchitecture}" "compilerId;${CMAKE_CXX_COMPILER_ID}" "compilerVersion;${CMAKE_CXX_COMPILER_VERSION}" "toolset;${CMAKE_VS_PLATFORM_TOOLSET}")
    list(GET pair 0 key)
    list(LENGTH pair pairLength)
    set(value "")
    if(pairLength GREATER 1)
        list(GET pair 1 value)
    endif()
    udkJsonString(quoted "${value}")
    string(JSON udkPackageContract SET "${udkPackageContract}" "${key}" "${quoted}")
endforeach()
set(udkPackageRuntime NotApplicable)
if(MSVC)
    set(udkPackageRuntime "${UniversalDevKitRuntime}")
endif()
udkJsonString(quoted "${udkPackageRuntime}")
string(JSON udkPackageContract SET "${udkPackageContract}" runtime "${quoted}")
string(JSON udkPackageContract SET "${udkPackageContract}" pointerSize "${CMAKE_SIZEOF_VOID_P}")
string(JSON udkPackageContract SET "${udkPackageContract}" components "[]")
set(componentIndex 0)
set(udkRuntimeFiles "[]")
set(runtimeIndex 0)
foreach(componentTarget IN LISTS exportedComponentTargets)
    get_target_property(componentType ${componentTarget} TYPE)
    if(componentType STREQUAL "INTERFACE_LIBRARY")
        continue()
    endif()
    get_target_property(componentExportName ${componentTarget} EXPORT_NAME)
    string(REGEX REPLACE "\\.(Static|Dynamic)$" "" componentName "${componentExportName}")
    string(REGEX REPLACE "^.*\\." "" variant "${componentExportName}")
    string(JSON dependencies GET "${componentDefinitionJson_${componentName}}" dependencies)
    set(entry "{}")
    foreach(key IN ITEMS name variant)
        set(value "${componentName}")
        if(key STREQUAL "variant")
            set(value "${variant}")
        endif()
        udkJsonString(quoted "${value}")
        string(JSON entry SET "${entry}" "${key}" "${quoted}")
    endforeach()
    string(JSON entry SET "${entry}" dependencies "${dependencies}")
    set(udkPackageLinkFile_${componentIndex} "${CMAKE_INSTALL_LIBDIR}/$<TARGET_LINKER_FILE_NAME:${componentTarget}>")
    string(JSON udkPackageContract SET "${udkPackageContract}" components ${componentIndex} "${entry}")
    math(EXPR componentIndex "${componentIndex} + 1")
    if(componentType STREQUAL "SHARED_LIBRARY")
        set(runtimeDirectory "${CMAKE_INSTALL_LIBDIR}")
        if(WIN32)
            set(runtimeDirectory "${CMAKE_INSTALL_BINDIR}")
        endif()
        udkJsonString(quoted "${runtimeDirectory}/$<TARGET_FILE_NAME:${componentTarget}>")
        string(JSON udkRuntimeFiles SET "${udkRuntimeFiles}" ${runtimeIndex} "${quoted}")
        math(EXPR runtimeIndex "${runtimeIndex} + 1")
        if(UNIX)
            # ELF loader использует SONAME; доставляются и файл, и его версионная ссылка.
            udkJsonString(quoted "${runtimeDirectory}/$<TARGET_SONAME_FILE_NAME:${componentTarget}>")
            string(JSON udkRuntimeFiles SET "${udkRuntimeFiles}" ${runtimeIndex} "${quoted}")
            math(EXPR runtimeIndex "${runtimeIndex} + 1")
        endif()
    endif()
endforeach()

set(udkPackageRecord "${udkPackageContract}")
if(componentIndex GREATER 0)
    math(EXPR lastComponentIndex "${componentIndex} - 1")
    foreach(index RANGE ${lastComponentIndex})
        udkJsonString(quoted "${udkPackageLinkFile_${index}}")
        string(JSON udkPackageRecord SET "${udkPackageRecord}" components ${index} linkFile "${quoted}")
    endforeach()
endif()
udkJsonString(quoted "$<CONFIG>")
string(JSON udkPackageRecord SET "${udkPackageRecord}" configuration "${quoted}")
string(JSON udkPackageRecord SET "${udkPackageRecord}" runtimeFiles "${udkRuntimeFiles}")
string(JSON udkPackageRecord SET "${udkPackageRecord}" abi "{}")
udkJsonString(quoted "Unverified")
if(MSVC)
    udkJsonString(quoted "MSVC STL; default iterator debug level")
    string(JSON udkPackageRecord SET "${udkPackageRecord}" abi iteratorDebugLevel "\"$<IF:$<CONFIG:Debug>,2,0>\"")
endif()
string(JSON udkPackageRecord SET "${udkPackageRecord}" abi standardLibrary "${quoted}")
# Числовые ABI-значения с generator expressions добавляем после обработки JSON.
if(MSVC)
    string(REPLACE "\"$<IF:$<CONFIG:Debug>,2,0>\"" "$<IF:$<CONFIG:Debug>,2,0>" udkPackageRecord "${udkPackageRecord}")
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKit.Build-$<CONFIG>.json" CONTENT "${udkPackageRecord}")

configure_file("${CMAKE_CURRENT_LIST_DIR}/InstallPackageGuard.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/InstallPackageGuard.cmake" @ONLY)
install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/InstallPackageGuard.cmake")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKit.Build-$<CONFIG>.json" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/UniversalDevKit")
configure_file("${CMAKE_CURRENT_LIST_DIR}/PackageCompatibility.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKitCompatibility.cmake" @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKitCompatibility.cmake" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/UniversalDevKit")

if(MSVC)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/PackageAbi.h.in" "${CMAKE_CURRENT_BINARY_DIR}/PackageAbi.h.in" @ONLY)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKit.Abi-$<CONFIG>.h" INPUT "${CMAKE_CURRENT_BINARY_DIR}/PackageAbi.h.in")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKit.Abi-$<CONFIG>.h" DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/UniversalDevKit")
    # Проверка действует также при собственной сборке: метаданные не обещают иной STL ABI.
    foreach(componentTarget IN LISTS exportedComponentTargets)
        get_target_property(componentType ${componentTarget} TYPE)
        if(NOT componentType STREQUAL "INTERFACE_LIBRARY")
            target_compile_options(${componentTarget} PRIVATE "/FI${CMAKE_CURRENT_BINARY_DIR}/UniversalDevKit.Abi-$<CONFIG>.h")
        endif()
    endforeach()
endif()