include_guard(GLOBAL)
get_filename_component(UniversalDevKitSourceRoot "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(ANDROID AND NOT ANDROID_STL STREQUAL "c++_shared")
    message(FATAL_ERROR "UDK XAML consumers require ANDROID_STL=c++_shared")
endif()
if(NOT TARGET UniversalDevKit::OpenGLESRenderer.Static)
    set(UniversalDevKit_COMPONENTS "OpenGLESRenderer" CACHE STRING "UDK components" FORCE)
    set(UniversalDevKit_BUILD_STATIC ON CACHE BOOL "Static UDK components" FORCE)
    set(UniversalDevKit_BUILD_DYNAMIC OFF CACHE BOOL "Dynamic UDK roots" FORCE)
    set(UniversalDevKit_INSTALL OFF CACHE BOOL "UDK install" FORCE)
    add_subdirectory("${UniversalDevKitSourceRoot}" "${CMAKE_BINARY_DIR}/UniversalDevKit")
endif()
if(NOT TARGET XamlRuntime::Logging)
    add_library(XamlRuntime::Logging ALIAS universaldevkit_diagnostic_dynamic)
endif()

function(udk_xaml_copy_runtime target)
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:universaldevkit_diagnostic_dynamic> $<TARGET_FILE_DIR:${target}>)
    if(ANDROID)
        if(ANDROID_ABI STREQUAL "arm64-v8a")
            set(runtimeTriple aarch64-linux-android)
        elseif(ANDROID_ABI STREQUAL "x86_64")
            set(runtimeTriple x86_64-linux-android)
        else()
            message(FATAL_ERROR "The UDK Android profile supports arm64-v8a and x86_64")
        endif()
        set(cxxShared "${CMAKE_SYSROOT}/usr/lib/${runtimeTriple}/libc++_shared.so")
        if(NOT EXISTS "${cxxShared}")
            message(FATAL_ERROR "The selected NDK does not provide ${cxxShared}")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different "${cxxShared}" $<TARGET_FILE_DIR:${target}>)
    elseif(WIN32)
        if(EXISTS "${UniversalDevKitAngleRoot}/runtimes/win-x64/native")
            set(angleDirectory "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/$<CONFIG>")
        else()
            set(angleDirectory "${UniversalDevKitAngleRoot}/$<IF:$<CONFIG:Debug>,debug/,>bin")
        endif()
        foreach(library libEGL.dll libGLESv2.dll)
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different "${angleDirectory}/${library}" $<TARGET_FILE_DIR:${target}>)
        endforeach()
        if(EXISTS "${UniversalDevKitAngleRoot}/runtimes/win-x64/native/Release/z.dll")
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different "${angleDirectory}/$<IF:$<CONFIG:Debug>,zd.dll,z.dll>" $<TARGET_FILE_DIR:${target}>)
        endif()
    endif()
endfunction()