# Generated by CMakeLists.txt. Edit the template to change the installed config.
# The CMake package template is processed by configure_package_config_file()
# to produce UniversalDevKitConfig.cmake for cmake --install.
# Consumers call find_package(UniversalDevKit CONFIG REQUIRED)
# and link targets such as UniversalDevKit::XamlRuntime.Static.
# This file is unused by add_subdirectory() and MSBuild.

# Replaced with package initialization code and CMake helper macros.
@PACKAGE_INIT@

# Create the system dependency target before loading exported libraries.
include(CMakeFindDependencyMacro)
@packageDependencyCommands@
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDevKitAngle.cmake" OPTIONAL)

# Load targets with library and header paths and build settings.
# Resolve the path relative to the installed configuration file.
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDevKitTargets.cmake")
if("@udkPackageHasBinaries@" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/UniversalDevKitCompatibility.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/UniversalDevKitCompatibility.cmake")
endif()

# Prevent implicit fallback between Debug and Release.
# Apply the CMake check only to targets used by the consumer.
set(packageConsumerConfigurations "${CMAKE_CONFIGURATION_TYPES}")
if(NOT packageConsumerConfigurations)
    if(CMAKE_BUILD_TYPE)
        set(packageConsumerConfigurations "${CMAKE_BUILD_TYPE}")
    else()
        set(packageConsumerConfigurations NOCONFIG)
    endif()
endif()

foreach(componentName IN ITEMS @availablePackageComponents@)
    foreach(componentVariant IN ITEMS Static Dynamic)
        set(componentImportedTarget "UniversalDevKit::${componentName}.${componentVariant}")
        if(TARGET ${componentImportedTarget})
            if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
                set_property(TARGET ${componentImportedTarget} PROPERTY MAP_IMPORTED_CONFIG_ NOCONFIG)
            endif()
            foreach(consumerConfiguration IN LISTS packageConsumerConfigurations)
                string(TOUPPER "${consumerConfiguration}" consumerConfigurationUpper)
                set_property(TARGET ${componentImportedTarget} PROPERTY "MAP_IMPORTED_CONFIG_${consumerConfigurationUpper}" "${consumerConfigurationUpper}")
            endforeach()
        endif()
    endforeach()
endforeach()

# All targets load together. These flags let CMake check requested COMPONENTS.
# Unknown components stay unset and are treated as missing.
set(UniversalDevKit_AVAILABLE_COMPONENTS "@availablePackageComponents@")
foreach(componentName IN LISTS UniversalDevKit_FIND_COMPONENTS)
    set(UniversalDevKit_${componentName}_FOUND FALSE)
endforeach()

foreach(componentName IN LISTS UniversalDevKit_AVAILABLE_COMPONENTS)
    set(UniversalDevKit_${componentName}_FOUND TRUE)
endforeach()

# Validate required COMPONENTS requested through find_package().
check_required_components(UniversalDevKit)