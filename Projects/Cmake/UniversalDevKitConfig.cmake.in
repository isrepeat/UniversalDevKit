# Шаблон CMake-пакета: configure_package_config_file() создаёт из него
# UniversalDevKitConfig.cmake, который устанавливается через cmake --install.
# Потребитель вызывает find_package(UniversalDevKit CONFIG REQUIRED)
# и подключает targets, например UniversalDevKit::Helpers.Static.
# При add_subdirectory() и MSBuild этот файл не используется.

# Заменяется кодом инициализации пакета и вспомогательными макросами CMake.
@PACKAGE_INIT@

# Создаём target системной зависимости до загрузки экспортированных библиотек.
include(CMakeFindDependencyMacro)
@packageDependencyCommands@

# Загружает targets с путями к библиотекам, заголовкам и настройками.
# Путь отсчитывается от установленного файла конфигурации.
include("${CMAKE_CURRENT_LIST_DIR}/UniversalDevKitTargets.cmake")

# Запрещаем неявную подстановку Release вместо Debug и наоборот.
# Проверка CMake применяется только к targets, используемым consumer.
set(packageConsumerConfigurations "${CMAKE_CONFIGURATION_TYPES}")
if(NOT packageConsumerConfigurations)
    if(CMAKE_BUILD_TYPE)
        set(packageConsumerConfigurations "${CMAKE_BUILD_TYPE}")
    else()
        set(packageConsumerConfigurations NOCONFIG)
    endif()
endif()

foreach(componentName IN ITEMS @availablePackageComponents@)
    foreach(componentVariant IN ITEMS Static Dynamic)
        set(componentImportedTarget "UniversalDevKit::${componentName}.${componentVariant}")
        if(TARGET ${componentImportedTarget})
            if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
                set_property(TARGET ${componentImportedTarget} PROPERTY MAP_IMPORTED_CONFIG_ NOCONFIG)
            endif()
            foreach(consumerConfiguration IN LISTS packageConsumerConfigurations)
                string(TOUPPER "${consumerConfiguration}" consumerConfigurationUpper)
                set_property(TARGET ${componentImportedTarget} PROPERTY "MAP_IMPORTED_CONFIG_${consumerConfigurationUpper}" "${consumerConfigurationUpper}")
            endforeach()
        endif()
    endforeach()
endforeach()

# Все targets загружаются вместе, но эти признаки позволяют проверить COMPONENTS.
# Неизвестный компонент не получает значение TRUE и считается ненайденным.
set(UniversalDevKit_AVAILABLE_COMPONENTS "@availablePackageComponents@")
foreach(componentName IN LISTS UniversalDevKit_FIND_COMPONENTS)
    set(UniversalDevKit_${componentName}_FOUND FALSE)
endforeach()

foreach(componentName IN LISTS UniversalDevKit_AVAILABLE_COMPONENTS)
    set(UniversalDevKit_${componentName}_FOUND TRUE)
endforeach()

# Проверяет обязательные COMPONENTS, запрошенные через find_package().
check_required_components(UniversalDevKit)