# Проверяем общий контракт до создания targets, включая требования других платформ.
function(udkReadComponentRequirements componentDefinitionJson)
    set(componentRequiredStandard 20)
    set(componentRequiresThreads FALSE)
    set(componentSystemLibraries)
    string(JSON requirementType ERROR_VARIABLE requirementError TYPE "${componentDefinitionJson}" "requirements")
    if(NOT requirementError)
        if(NOT requirementType STREQUAL "OBJECT")
            message(FATAL_ERROR "requirements must be an object")
        endif()
        string(JSON requirementCount LENGTH "${componentDefinitionJson}" "requirements")
        if(requirementCount GREATER 0)
            math(EXPR requirementLastIndex "${requirementCount} - 1")
            foreach(requirementIndex RANGE ${requirementLastIndex})
                string(JSON requirementName MEMBER "${componentDefinitionJson}" "requirements" ${requirementIndex})
                string(JSON requirementType TYPE "${componentDefinitionJson}" "requirements" "${requirementName}")
                string(JSON requirementValue GET "${componentDefinitionJson}" "requirements" "${requirementName}")
                if(requirementName STREQUAL "cxxStandard")
                    if(NOT requirementType STREQUAL "NUMBER" OR NOT requirementValue MATCHES "^(20|23)$")
                        message(FATAL_ERROR "cxxStandard must be 20 or 23")
                    endif()
                    set(componentRequiredStandard "${requirementValue}")
                elseif(requirementName STREQUAL "threads")
                    if(NOT requirementType STREQUAL "BOOLEAN")
                        message(FATAL_ERROR "threads must be a boolean")
                    endif()
                    set(componentRequiresThreads "${requirementValue}")
                else()
                    message(FATAL_ERROR "Unknown requirement: ${requirementName}")
                endif()
            endforeach()
        endif()
    endif()
    string(JSON platformRequirementType ERROR_VARIABLE platformRequirementError TYPE "${componentDefinitionJson}" "platformRequirements")
    if(NOT platformRequirementError)
        if(NOT platformRequirementType STREQUAL "OBJECT")
            message(FATAL_ERROR "platformRequirements must be an object")
        endif()
        string(JSON platformRequirementCount LENGTH "${componentDefinitionJson}" "platformRequirements")
        if(platformRequirementCount GREATER 0)
            math(EXPR platformRequirementLastIndex "${platformRequirementCount} - 1")
            foreach(platformRequirementIndex RANGE ${platformRequirementLastIndex})
                string(JSON platformName MEMBER "${componentDefinitionJson}" "platformRequirements" ${platformRequirementIndex})
                if(NOT platformName MATCHES "^(Windows|Linux|Android)$")
                    message(FATAL_ERROR "Invalid platform requirement: ${platformName}")
                endif()
                string(JSON platformSettingsType TYPE "${componentDefinitionJson}" "platformRequirements" "${platformName}")
                if(NOT platformSettingsType STREQUAL "OBJECT")
                    message(FATAL_ERROR "Platform requirements must be an object: ${platformName}")
                endif()
                string(JSON platformSettingCount LENGTH "${componentDefinitionJson}" "platformRequirements" "${platformName}")
                if(NOT platformSettingCount EQUAL 1)
                    message(FATAL_ERROR "Platform requirements must contain only linkLibraries")
                endif()
                string(JSON platformSettingName MEMBER "${componentDefinitionJson}" "platformRequirements" "${platformName}" 0)
                if(NOT platformSettingName STREQUAL "linkLibraries")
                    message(FATAL_ERROR "Unknown platform requirement: ${platformSettingName}")
                endif()
                string(JSON libraryListType TYPE "${componentDefinitionJson}" "platformRequirements" "${platformName}" "linkLibraries")
                if(NOT libraryListType STREQUAL "ARRAY")
                    message(FATAL_ERROR "linkLibraries must be an array")
                endif()
                string(JSON systemLibraryCount LENGTH "${componentDefinitionJson}" "platformRequirements" "${platformName}" "linkLibraries")
                if(systemLibraryCount GREATER 0)
                    math(EXPR systemLibraryLastIndex "${systemLibraryCount} - 1")
                    foreach(systemLibraryIndex RANGE ${systemLibraryLastIndex})
                        string(JSON systemLibraryType TYPE "${componentDefinitionJson}" "platformRequirements" "${platformName}" "linkLibraries" ${systemLibraryIndex})
                        string(JSON systemLibraryName GET "${componentDefinitionJson}" "platformRequirements" "${platformName}" "linkLibraries" ${systemLibraryIndex})
                        if(NOT systemLibraryType STREQUAL "STRING" OR NOT systemLibraryName MATCHES "^[A-Za-z0-9_+.-]+$")
                            message(FATAL_ERROR "Invalid system library: ${systemLibraryName}")
                        endif()
                        if(platformName STREQUAL CMAKE_SYSTEM_NAME)
                            list(APPEND componentSystemLibraries "${systemLibraryName}")
                        endif()
                    endforeach()
                endif()
            endforeach()
        endif()
    endif()
    list(REMOVE_DUPLICATES componentSystemLibraries)
    set(componentRequiredStandard "${componentRequiredStandard}" PARENT_SCOPE)
    set(componentRequiresThreads "${componentRequiresThreads}" PARENT_SCOPE)
    set(componentSystemLibraries "${componentSystemLibraries}" PARENT_SCOPE)
endfunction()