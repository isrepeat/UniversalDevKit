function(udkValidateBuildIdentity identityFile actualIdentity)
    if(EXISTS "${identityFile}")
        file(READ "${identityFile}" previousIdentity)
        string(REGEX REPLACE "[\r\n]+$" "" previousIdentity "${previousIdentity}")
        if(NOT previousIdentity STREQUAL actualIdentity)
            message(FATAL_ERROR "UniversalDevKit compiler/architecture/runtime changed: use a separate build directory. Expected [${previousIdentity}], actual [${actualIdentity}]")
        endif()
    endif()
endfunction()