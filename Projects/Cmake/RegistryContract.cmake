# Общие правила версии и структуры реестра проверяются до создания targets.
include("${CMAKE_CURRENT_LIST_DIR}/ThirdParty.cmake")
function(udkCheckObjectKeys json allowed label)
    string(JSON kind TYPE "${json}")
    if(NOT kind STREQUAL "OBJECT")
        message(FATAL_ERROR "${label} must be an object")
    endif()
    string(JSON count LENGTH "${json}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON key MEMBER "${json}" ${index})
            if(NOT key IN_LIST allowed)
                message(FATAL_ERROR "Unsupported field in ${label}: ${key}")
            endif()
        endforeach()
    endif()
endfunction()

function(udkCheckRegistryPath path)
    if(IS_ABSOLUTE "${path}" OR path MATCHES "[\\\\:$@%*?;\r\n]" OR path MATCHES "(^|/)(\\.\\.?|)(/|$)")
        message(FATAL_ERROR "Invalid registry path: ${path}")
    endif()
endfunction()

function(udkCheckComponentContract json)
    udkCheckObjectKeys("${json}" "name;msbuildGuid;headers;sources;filters;dependencies;supportedPlatforms;platformSources;stateScope;requirements;platformRequirements;buildExtensions;thirdParty;kind" component)
    udkReadThirdParty("${json}")
    foreach(key IN ITEMS name msbuildGuid)
        string(JSON type TYPE "${json}" ${key})
        if(NOT type STREQUAL "STRING")
            message(FATAL_ERROR "${key} must be a string")
        endif()
    endforeach()
    foreach(key IN ITEMS headers sources)
        string(JSON type TYPE "${json}" ${key})
        if(NOT type STREQUAL "ARRAY")
            message(FATAL_ERROR "${key} must be an array")
        endif()
        string(JSON count LENGTH "${json}" ${key})
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            string(JSON component GET "${json}" name)
            foreach(index RANGE ${last})
                string(JSON type TYPE "${json}" ${key} ${index})
                string(JSON path GET "${json}" ${key} ${index})
                udkCheckRegistryPath("${path}")
                if(key STREQUAL "headers")
                    set(prefix "Includes/${component}/UniversalDevKit/${component}/")
                else()
                    set(prefix "Sources/${component}/")
                endif()
                string(FIND "${path}" "${prefix}" position)
                if(key STREQUAL "headers" AND NOT position EQUAL 0)
                    string(FIND "${path}" "Sources/${component}/" position)
                endif()
                if(NOT type STREQUAL "STRING" OR NOT position EQUAL 0 OR NOT EXISTS "${PROJECT_SOURCE_DIR}/${path}")
                    message(FATAL_ERROR "Invalid component file: ${path}")
                endif()
                if(key STREQUAL "sources" AND NOT path MATCHES "\\.cpp$")
                    message(FATAL_ERROR "Expected .cpp source: ${path}")
                endif()
            endforeach()
        endif()
    endforeach()
    string(JSON kind ERROR_VARIABLE missing GET "${json}" kind)
    if(missing)
        set(kind compiled)
    elseif(NOT kind MATCHES "^(compiled|headerOnly)$")
        message(FATAL_ERROR "Invalid component kind")
    endif()
    string(JSON guid GET "${json}" msbuildGuid)
    string(LENGTH "${guid}" guidLength)
    if(NOT guidLength EQUAL 38 OR NOT guid MATCHES "^\\{[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9A-Fa-f]+\\}$")
        message(FATAL_ERROR "Invalid msbuildGuid")
    endif()
    foreach(position IN ITEMS 9 14 19 24)
        string(SUBSTRING "${guid}" ${position} 1 separator)
        if(NOT separator STREQUAL "-")
            message(FATAL_ERROR "Invalid msbuildGuid segment length")
        endif()
    endforeach()
    string(JSON scope ERROR_VARIABLE missing GET "${json}" stateScope)
    if(NOT missing AND NOT scope MATCHES "^(module|process)$")
        message(FATAL_ERROR "Invalid stateScope")
    endif()
    if(kind STREQUAL "headerOnly")
        string(JSON count LENGTH "${json}" sources)
        foreach(key IN ITEMS platformSources buildExtensions)
            string(JSON value ERROR_VARIABLE missing GET "${json}" ${key})
            if(NOT missing)
                message(FATAL_ERROR "Header-only component cannot contain ${key}")
            endif()
        endforeach()
        if(count GREATER 0 OR scope STREQUAL "process")
            message(FATAL_ERROR "Header-only component cannot contain sources or process state")
        endif()
    endif()
    string(JSON dependencies ERROR_VARIABLE missing GET "${json}" dependencies)
    if(NOT missing)
        string(JSON type TYPE "${json}" dependencies)
        if(NOT type STREQUAL "ARRAY")
            message(FATAL_ERROR "dependencies must be an array")
        endif()
        string(JSON count LENGTH "${json}" dependencies)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            set(names)
            foreach(index RANGE ${last})
                string(JSON dependency GET "${json}" dependencies ${index})
                udkCheckObjectKeys("${dependency}" "component;visibility;linkage" dependency)
                string(JSON name GET "${dependency}" component)
                string(JSON visibility GET "${dependency}" visibility)
                string(JSON linkage GET "${dependency}" linkage)
                if(NOT name MATCHES "^[A-Z][A-Za-z0-9]*$" OR name IN_LIST names OR
                   NOT visibility MATCHES "^(public|private)$" OR NOT linkage MATCHES "^(same|static|dynamic)$")
                    message(FATAL_ERROR "Invalid dependency contract")
                endif()
                if(kind STREQUAL "headerOnly" AND (NOT visibility STREQUAL "public" OR NOT linkage STREQUAL "same"))
                    message(FATAL_ERROR "Header-only dependencies must be public/same")
                endif()
                list(APPEND names "${name}")
            endforeach()
        endif()
    endif()
    set(componentKind "${kind}" PARENT_SCOPE)
endfunction()