<?xml version="1.0" encoding="utf-8"?>
<Component name="XamlCompiler">
  <Files>
    <Group name="CMakeRules">
      <File>Sources/Windows/XamlCompiler/CMakeLists.txt</File>
    </Group>
  </Files>
  <Filters>
    <Filter filter="{Tree:Solution}/Sources/Windows/XamlCompiler">
      <GroupRef>CMakeRules</GroupRef>
    </Filter>
  </Filters>
  <Projects>
    <Project id="native"
             kind="application"
             projectType="native">
      <Files>
        <Header>Sources/Windows/XamlCompiler/**/*.h</Header>
        <Source>Sources/Windows/XamlCompiler/**/*.cpp</Source>
      </Files>
      <Filters>
        <Filter filter="{Tree:Project}/Sources">
          <Match>Sources/Windows/XamlCompiler/**/*</Match>
        </Filter>
      </Filters>
      <Requirements cxxStandard="20" />
    </Project> <!-- Project id="native" -->
  </Projects>
</Component>