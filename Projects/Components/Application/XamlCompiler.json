{
  "name": "XamlCompiler",
  "projects": [
    {
      "kind": "application",
      "projectType": "native",
      "msbuild": {
        "projectNames": {
          "Shared": "UniversalDevKit.{name}.Shared"
        }
      },
      "headers": ["Sources/Windows/XamlCompiler/**/*.h"],
      "sources": ["Sources/Windows/XamlCompiler/**/*.cpp"],
      "filters": [
        { "path": "Sources/Windows/XamlCompiler", "filter": "Sources" }
      ],
      "requirements": {
        "cxxStandard": 20
      }
    }
  ]
}