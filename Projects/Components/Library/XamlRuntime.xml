        <Group id="NativeSources">
          <Input role="source">Sources/XamlRuntime/**/*.cpp</Input>
        </Group>
      </Files>
      <Filters>
        <Filter filter="{Tree:Solution}/Sources/XamlRuntime">
          <Ref tag="Group" id="CMakeRules" />
        </Filter>
        <Filter filter="{Tree:Project}"
                preserveTree="true">
          <Ref tag="Group" id="PublicHeaders" />
        </Filter>
        <Filter filter="{Tree:Project}"
                preserveTree="true">
          <Ref tag="Group" id="NativeSources" />
        </Filter>
      </Filters>
      <Requirements cxxStandard="20" />
      <Extension backend="MSBuild">
        <Files>
          <Group id="NativeBuild">
            <Input role="msbuild-targets">Sources/XamlRuntime/UniversalDevKit.XamlRuntime.targets</Input>
          </Group>
        </Files>
        <Filters>
          <Filter filter="{Tree:Project}/Build">
            <Ref tag="Group" id="NativeBuild" />
            <Ref tag="Output" id="DependenciesProps" />
          </Filter>
        </Filters>
      </Extension>
      <Extension backend="CMake">
        <Files>
          <Group id="CMakeRules">
            <Input role="cmake">Sources/XamlRuntime/Build.cmake</Input>
            <File>Sources/XamlRuntime/Consumer.cmake</File>
          </Group>
        </Files>
      </Extension>
    </Project> <!-- Project id="native" -->
  </Projects>
