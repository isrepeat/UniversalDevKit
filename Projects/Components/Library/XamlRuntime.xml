    <Filter filter="{Tree:Solution}/ThirdParty/XamlRuntime"
            preserveTree="true">
      <Ref tag="Group" id="ThirdParty" />
    </Filter>
  </Filters>
  <Projects>
    <Project id="native"
             target="XamlRuntime.Native"
             kind="library"
             projectType="native"
             projectGuid="{3E00A02D-46F3-432B-91C8-5D459F70C525}">
      <SupportedPlatforms>Windows;Android</SupportedPlatforms>
      <Dependencies>
        <Dependency component="Helpers"
                    visibility="public"
                    linkage="same" />
        <Dependency component="Diagnostic"
                    visibility="private"
                    linkage="dynamic" />
      </Dependencies>
      <ConsumerIntegration>
        <MSBuild props="Sources/XamlRuntime/MsBuild/XamlRuntime.Usage.props" />
        <CMake script="Sources/XamlRuntime/Cmake/XamlRuntime.Usage.cmake" />
      </ConsumerIntegration>
      <Files>
        <Group id="PublicHeaders">
          <Input role="header">Includes/XamlRuntime/UniversalDevKit/XamlRuntime/**/*.h</Input>
