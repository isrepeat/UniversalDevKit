<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <__UniversalDevKitMetaPackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitMetaPackageRoot>
    <__UniversalDevKitMetaPackageVersion>$(__UniversalDevKitMetaPackageVersion)</__UniversalDevKitMetaPackageVersion>
    <UniversalDevKitMetaLinkage Condition="'$(UniversalDevKitMetaLinkage)' == ''">Shared</UniversalDevKitMetaLinkage>
  </PropertyGroup>
  <Import Project="Generated\Settings.targets" />
  <ItemGroup>
    <__UniversalDevKitNuGetRoot Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Target Name="__UniversalDevKitMetaValidateNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="UniversalDevKit.Meta: only Windows x64 is packaged." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="UniversalDevKit.Meta: select Debug or Release." />
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="Set UniversalDevKitComponents to explicitly selected root components." />
    <Error Condition="!$([System.String]::Copy(';$(__UniversalDevKitMetaValidModes);').Contains(';$(UniversalDevKitMetaLinkage);'))" Text="UniversalDevKit.Meta: unsupported linkage." />
    <Error Condition="'$(__UniversalDevKitMetaPackageRoot)' == ''" Text="UniversalDevKit package import is missing." />
  </Target>
</Project>