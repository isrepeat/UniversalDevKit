<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <__UniversalDevKitOpenGLESRendererPackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitOpenGLESRendererPackageRoot>
    <__UniversalDevKitOpenGLESRendererPackageVersion>$(__UniversalDevKitOpenGLESRendererPackageVersion)</__UniversalDevKitOpenGLESRendererPackageVersion>
    <UniversalDevKitOpenGLESRendererLinkage Condition="'$(UniversalDevKitOpenGLESRendererLinkage)' == ''">Static</UniversalDevKitOpenGLESRendererLinkage>
  </PropertyGroup>
  <Import Project="Generated\Settings.targets" />
  <ItemGroup>
    <__UniversalDevKitNuGetRoot Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Target Name="__UniversalDevKitOpenGLESRendererValidateNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="UniversalDevKit.OpenGLESRenderer: only Windows x64 is packaged." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="UniversalDevKit.OpenGLESRenderer: select Debug or Release." />
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="Set UniversalDevKitComponents to explicitly selected root components." />
    <Error Condition="!$([System.String]::Copy(';$(__UniversalDevKitOpenGLESRendererValidModes);').Contains(';$(UniversalDevKitOpenGLESRendererLinkage);'))" Text="UniversalDevKit.OpenGLESRenderer: unsupported linkage." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Static' and '$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKitRuntime must be Static (MT) or Dynamic (MD)." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKit.OpenGLESRenderer requires Dynamic CRT (MD/MDd); its dependency Diagnostic uses a shared C++ runtime." />
    <Error Condition="'$(__UniversalDevKitOpenGLESRendererHasBinaries)' == 'true' and '$(PlatformToolset)' != '$(__UniversalDevKitOpenGLESRendererExpectedToolset)'" Text="UniversalDevKit.OpenGLESRenderer: package requires toolset $(__UniversalDevKitOpenGLESRendererExpectedToolset)." />
    <Error Condition="'$(__UniversalDevKitOpenGLESRendererHasBinaries)' == 'true' and '$(VCToolsVersion)' != '$(__UniversalDevKitOpenGLESRendererExpectedTools)'" Text="UniversalDevKit.OpenGLESRenderer: package requires MSVC tools $(__UniversalDevKitOpenGLESRendererExpectedTools)." />
    <Error Condition="'$(__UniversalDevKitOpenGLESRendererPackageRoot)' == ''" Text="UniversalDevKit package import is missing." />

  </Target>
  <Target Name="__UniversalDevKitOpenGLESRendererCopyNuGetRuntime" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(__UniversalDevKitOpenGLESRendererNuGetRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="Angle.targets" />
</Project>