<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="Generated\Settings.props" />
  <PropertyGroup>
    <__UniversalDevKitHeleprsTestPackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitHeleprsTestPackageRoot>

    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <UniversalDevKitHeleprsTestLinkage Condition="'$(UniversalDevKitHeleprsTestLinkage)' == ''">Static</UniversalDevKitHeleprsTestLinkage>
  </PropertyGroup>
</Project>