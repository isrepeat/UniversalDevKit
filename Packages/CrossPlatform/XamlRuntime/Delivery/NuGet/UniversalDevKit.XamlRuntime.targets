<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <__UniversalDevKitXamlRuntimePackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitXamlRuntimePackageRoot>
    <__UniversalDevKitXamlRuntimePackageVersion>$(__UniversalDevKitXamlRuntimePackageVersion)</__UniversalDevKitXamlRuntimePackageVersion>
    <UniversalDevKitXamlRuntimeLinkage Condition="'$(UniversalDevKitXamlRuntimeLinkage)' == ''">Static</UniversalDevKitXamlRuntimeLinkage>
  </PropertyGroup>
  <Import Project="Generated\Settings.targets" />
  <ItemGroup>
    <__UniversalDevKitNuGetRoot Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Target Name="__UniversalDevKitXamlRuntimeValidateNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="UniversalDevKit.XamlRuntime: only Windows x64 is packaged." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="UniversalDevKit.XamlRuntime: select Debug or Release." />
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="Set UniversalDevKitComponents to explicitly selected root components." />
    <Error Condition="!$([System.String]::Copy(';$(__UniversalDevKitXamlRuntimeValidModes);').Contains(';$(UniversalDevKitXamlRuntimeLinkage);'))" Text="UniversalDevKit.XamlRuntime: unsupported linkage." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Static' and '$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKitRuntime must be Static (MT) or Dynamic (MD)." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKit.XamlRuntime requires Dynamic CRT (MD/MDd); its dependency Diagnostic uses a shared C++ runtime." />
    <Error Condition="'$(__UniversalDevKitXamlRuntimeHasBinaries)' == 'true' and '$(PlatformToolset)' != '$(__UniversalDevKitXamlRuntimeExpectedToolset)'" Text="UniversalDevKit.XamlRuntime: package requires toolset $(__UniversalDevKitXamlRuntimeExpectedToolset)." />
    <Error Condition="'$(__UniversalDevKitXamlRuntimeHasBinaries)' == 'true' and '$(VCToolsVersion)' != '$(__UniversalDevKitXamlRuntimeExpectedTools)'" Text="UniversalDevKit.XamlRuntime: package requires MSVC tools $(__UniversalDevKitXamlRuntimeExpectedTools)." />
    <Error Condition="'$(__UniversalDevKitXamlRuntimePackageRoot)' == ''" Text="UniversalDevKit package import is missing." />

  </Target>
  <Target Name="__UniversalDevKitXamlRuntimeCopyNuGetRuntime" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(__UniversalDevKitXamlRuntimeNuGetRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>