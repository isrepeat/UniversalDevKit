{
  "schemaVersion": 2,
  "name": "XamlRuntime",
  "version": "${UDK_VERSION.version}",
  "projects": {
    "windows": {
      "adapter": "udk-native",
      "component": "XamlRuntime",
      "generator": "Visual Studio 18 2026"
    },
    "android": {
      "adapter": "udk-prefab",
      "component": "XamlRuntime",
      "configuration": "Release",
      "abis": [
        "arm64-v8a",
        "x86_64"
      ],
      "apiLevel": 24,
      "toolchain": "Scripts/Android/ResolveToolchain.ps1"
    }
  },
  "contents": [
    {
      "project": "windows",
      "root": "output",
      "destination": ".",
      "deliveries": [
        "NuGet"
      ]
    },
    {
      "project": "android",
      "root": "output",
      "destination": ".",
      "deliveries": [
        "Android"
      ]
    },
    {
      "source": ".",
      "include": [
        "LICENSE",
        "Packages/Build/NuGet/README.md"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "LICENSE": "LICENSE.txt"
      },
      "deliveries": [
        "NuGet"
      ]
    }
  ],
  "deliveries": {
    "Android": "Delivery/Android/Delivery.json",
    "NuGet": "Delivery/NuGet/Delivery.json"
  },
  "releaseDependencies": [
    {
      "package": "../Helpers/Package.json",
      "delivery": "NuGet",
      "when": [
        "NuGet"
      ]
    },
    {
      "package": "../Diagnostic/Package.json",
      "delivery": "NuGet",
      "when": [
        "NuGet"
      ]
    }
  ]
}