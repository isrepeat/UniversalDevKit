<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="Generated\Settings.props" />
  <PropertyGroup>
    <__UniversalDevKitDiagnosticPackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitDiagnosticPackageRoot>

    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <UniversalDevKitDiagnosticLinkage Condition="'$(UniversalDevKitDiagnosticLinkage)' == ''">Static</UniversalDevKitDiagnosticLinkage>
  </PropertyGroup>
</Project>