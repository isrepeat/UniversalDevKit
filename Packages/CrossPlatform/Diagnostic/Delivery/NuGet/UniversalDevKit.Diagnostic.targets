<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <__UniversalDevKitDiagnosticPackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitDiagnosticPackageRoot>
    <__UniversalDevKitDiagnosticPackageVersion>$(__UniversalDevKitDiagnosticPackageVersion)</__UniversalDevKitDiagnosticPackageVersion>
    <UniversalDevKitDiagnosticLinkage Condition="'$(UniversalDevKitDiagnosticLinkage)' == ''">Dynamic</UniversalDevKitDiagnosticLinkage>
  </PropertyGroup>
  <Import Project="Generated\Settings.targets" />
  <ItemGroup>
    <__UniversalDevKitNuGetRoot Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Target Name="__UniversalDevKitDiagnosticValidateNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="UniversalDevKit.Diagnostic: only Windows x64 is packaged." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="UniversalDevKit.Diagnostic: select Debug or Release." />
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="Set UniversalDevKitComponents to explicitly selected root components." />
    <Error Condition="!$([System.String]::Copy(';$(__UniversalDevKitDiagnosticValidModes);').Contains(';$(UniversalDevKitDiagnosticLinkage);'))" Text="UniversalDevKit.Diagnostic: unsupported linkage." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Static' and '$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKitRuntime must be Static (MT) or Dynamic (MD)." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKit.Diagnostic requires Dynamic CRT (MD/MDd); its C++ API shares allocated objects across the DLL boundary." />
    <Error Condition="'$(__UniversalDevKitDiagnosticHasBinaries)' == 'true' and '$(PlatformToolset)' != '$(__UniversalDevKitDiagnosticExpectedToolset)'" Text="UniversalDevKit.Diagnostic: package requires toolset $(__UniversalDevKitDiagnosticExpectedToolset)." />
    <Error Condition="'$(__UniversalDevKitDiagnosticHasBinaries)' == 'true' and '$(VCToolsVersion)' != '$(__UniversalDevKitDiagnosticExpectedTools)'" Text="UniversalDevKit.Diagnostic: package requires MSVC tools $(__UniversalDevKitDiagnosticExpectedTools)." />
    <Error Condition="'$(__UniversalDevKitDiagnosticPackageRoot)' == ''" Text="UniversalDevKit package import is missing." />

  </Target>
  <Target Name="__UniversalDevKitDiagnosticCopyNuGetRuntime" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(__UniversalDevKitDiagnosticNuGetRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>