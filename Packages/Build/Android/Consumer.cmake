# Адаптер читает контракт из восстановленного AAR, а не из checkout UDK.
function(udk_android_link target prefab_target)
    if(NOT ANDROID OR NOT TARGET ${prefab_target})
        message(FATAL_ERROR "Use an Android Prefab target with udk_android_link")
    endif()
    get_target_property(include_dirs ${prefab_target} INTERFACE_INCLUDE_DIRECTORIES)
    set(contract_path "")
    foreach(directory IN LISTS include_dirs)
        if(EXISTS "${directory}/UniversalDevKit/Android/contract.json")
            set(contract_path "${directory}/UniversalDevKit/Android/contract.json")
        endif()
    endforeach()
    if(NOT contract_path)
        message(FATAL_ERROR "UDK Android contract is missing")
    endif()
    file(READ "${contract_path}" contract)
    string(JSON schema GET "${contract}" schemaVersion)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "Unsupported UDK Android contract schema")
    endif()
    string(JSON version GET "${contract}" version)
    get_target_property(previous_version ${target} UDK_ANDROID_VERSION)
    if(previous_version AND NOT previous_version STREQUAL version)
        message(FATAL_ERROR "Conflicting UDK Android release versions")
    endif()
    set_property(TARGET ${target} PROPERTY UDK_ANDROID_VERSION "${version}")
    string(JSON api GET "${contract}" api)
    string(REGEX REPLACE "^android-" "" consumer_api "${ANDROID_PLATFORM}")
    if(NOT consumer_api MATCHES "^[0-9]+$" OR consumer_api LESS api)
        message(FATAL_ERROR "UDK Android API level is too low")
    endif()
    string(JSON stl GET "${contract}" stl)
    if(NOT CMAKE_ANDROID_STL_TYPE STREQUAL stl)
        message(FATAL_ERROR "UDK requires c++_shared for every participating native library")
    endif()
    string(JSON ndk GET "${contract}" ndk)
    file(READ "${CMAKE_ANDROID_NDK}/source.properties" ndk_properties)
    string(REGEX MATCH "Pkg.Revision[ \t]*=[ \t]*([0-9.]+)" ignored "${ndk_properties}")
    if(NOT CMAKE_MATCH_1 STREQUAL ndk)
        message(FATAL_ERROR "UDK NDK mismatch: package ${ndk}, consumer ${CMAKE_MATCH_1}")
    endif()
    string(JSON configuration GET "${contract}" configuration)
    if(NOT CMAKE_BUILD_TYPE STREQUAL configuration)
        message(FATAL_ERROR "UDK configuration mismatch: package ${configuration}, consumer ${CMAKE_BUILD_TYPE}")
    endif()
    string(JSON count LENGTH "${contract}" modes)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON component MEMBER "${contract}" modes ${index})
        string(JSON mode GET "${contract}" modes "${component}")
        get_target_property(existing ${target} UDK_ANDROID_VARIANT_${component})
        if(existing AND NOT existing STREQUAL mode)
            message(FATAL_ERROR "Conflicting UDK Android variant for ${component}: ${existing}/${mode}")
        endif()
        set_property(TARGET ${target} PROPERTY UDK_ANDROID_VARIANT_${component} "${mode}")
    endforeach()
    string(JSON standard GET "${contract}" cxxStandard)
    target_compile_features(${target} PRIVATE cxx_std_${standard})
    target_link_libraries(${target} PRIVATE ${prefab_target})
endfunction()