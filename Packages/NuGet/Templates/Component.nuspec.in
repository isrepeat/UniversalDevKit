<?xml version="1.0" encoding="utf-8"?>
<!-- Сгенерировано Build.ps1. Источник: реестр компонентов и Version.json. -->
<package>
  <metadata>
    <id>UniversalDevKit.{{COMPONENT}}</id>
    <version>{{VERSION}}</version>
    <authors>UniversalDevKit</authors>
    <description>UniversalDevKit {{COMPONENT}} native Windows x64 library.</description>
    <tags>native C++ Windows UniversalDevKit</tags>
    <license type="file">LICENSE.txt</license>
    <readme>README.md</readme>
    <dependencies><group targetFramework="native">{{DEPENDENCIES}}</group></dependencies>
  </metadata>
  <files><file src="payload\**\*" target="" /></files>
</package>