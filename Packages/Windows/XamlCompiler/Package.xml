<?xml version="1.0" encoding="utf-8"?>
<Package schemaVersion="2"
         name="XamlCompiler"
         version="${UDK_VERSION.version}"
         defaultDelivery="NuGet">
  <Projects>
    <Project id="compiler"
             adapter="cmake-build"
             sourceDirectory="Projects/Cmake/Application/XamlCompiler"
             generator="Visual Studio 18 2026"
             architecture="x64"
             parallel="2">
      <Configurations>Release</Configurations>
      <Variables />
    </Project>
  </Projects>
  <Contents>
    <Content project="compiler"
             root="build"
             path="Release"
             destination="tools/win-x64">
      <Includes>
        <Include>XamlCompiler.exe</Include>
      </Includes>
    </Content>
    <Content source="."
             destination="."
             preserveHierarchy="false">
      <Includes>
        <Include>LICENSE</Include>
      </Includes>
      <Rename>
        <File from="LICENSE">LICENSE.txt</File>
      </Rename>
    </Content>
  </Contents>
  <Deliveries>
    <Delivery name="NuGet">Delivery/NuGet/Delivery.xml</Delivery>
  </Deliveries>
</Package>