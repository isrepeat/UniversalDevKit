{
  "schemaVersion": 2,
  "name": "PackageTools",
  "versionSource": "Version.json",
  "projects": {
    "tool": {
      "adapter": "files",
      "mappings": [
        {
          "source": "Sources/Windows/PackageTools/Build.ps1",
          "destination": "tools/Build.ps1"
        },
        {
          "source": "Sources/Windows/PackageTools/Adapters",
          "destination": "tools/Adapters"
        },
        {
          "source": "Sources/Windows/PackageTools/Private",
          "destination": "tools/Private"
        },
        {
          "source": "Sources/Windows/PackageTools/Templates",
          "destination": "tools/Templates"
        },
        {
          "source": "Packages/Windows/PackageTools/Delivery/NuGet/UniversalDevKit.PackageTools.targets",
          "destination": "build/UniversalDevKit.PackageTools.targets"
        }
      ]
    }
  },
  "contents": [
    {
      "project": "tool",
      "root": "output",
      "destination": "."
    },
    {
      "source": ".",
      "include": [
        "LICENSE",
        "Packages/Windows/PackageTools/README.md"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "LICENSE": "LICENSE.txt"
      }
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  }
}