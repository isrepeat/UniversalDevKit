<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <UdkPackageRepository Condition="'$(UdkPackageRepository)' == ''">$(MSBuildProjectDirectory)</UdkPackageRepository>
    <UdkPackagePowerShell Condition="'$(UdkPackagePowerShell)' == ''">powershell.exe</UdkPackagePowerShell>
    <UdkPackageToolsEntry Condition="'$(UdkPackageToolsEntry)' == ''">$(MSBuildThisFileDirectory)..\tools\Build.ps1</UdkPackageToolsEntry>
    <__UniversalDevKitPackageTools>$(UdkPackageToolsEntry)</__UniversalDevKitPackageTools>
  </PropertyGroup>
  <Target Name="PackRepository">
    <Error Condition="'@(UdkPackage)' == ''" Text="Declare at least one UdkPackage item with a repository-relative Package.json path." />
    <Exec Command="&quot;$(UdkPackagePowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(__UniversalDevKitPackageTools)&quot; -RepositoryPath &quot;$(UdkPackageRepository)&quot; -PackagePath &quot;%(UdkPackage.Identity)&quot; -Delivery &quot;%(UdkPackage.Delivery)&quot; -PackageSources &quot;$(UdkPackageSources)&quot; -NuGet &quot;$(UdkPackageNuGet)&quot; -CMake &quot;$(UdkPackageCMake)&quot; -OutputDirectory &quot;$(UdkPackageOutput)&quot;" />
  </Target>
  <Target Name="PlanRepositoryPackages">
    <Error Condition="'@(UdkPackage)' == ''" Text="Declare at least one UdkPackage item with a repository-relative Package.json path." />
    <Exec Command="&quot;$(UdkPackagePowerShell)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(__UniversalDevKitPackageTools)&quot; -RepositoryPath &quot;$(UdkPackageRepository)&quot; -PackagePath &quot;%(UdkPackage.Identity)&quot; -Delivery &quot;%(UdkPackage.Delivery)&quot; -Plan" />
  </Target>
</Project>