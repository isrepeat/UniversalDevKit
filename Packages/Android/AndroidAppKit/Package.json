{
  "schemaVersion": 2,
  "name": "AndroidAppKit",
  "version": "1.0.19",
  "projects": {
    "gradle": {
      "adapter": "gradle-publish",
      "projectDirectory": "Projects/Gradle/AndroidAppKit",
      "tasks": [
        ":androidappkit:publishReleasePublicationToAndroidPackagesFeedRepository"
      ],
      "toolchain": "Scripts/Android/ResolveToolchain.ps1",
      "refreshDependencies": true
    }
  },
  "contents": [
    {
      "project": "gradle",
      "root": "output",
      "destination": "."
    }
  ],
  "deliveries": {
    "Android": "Delivery/Android/Delivery.json"
  },
  "releaseDependencies": [
    {
      "package": "../AndroidCoreSdk/Package.json",
      "delivery": "Android"
    }
  ]
}