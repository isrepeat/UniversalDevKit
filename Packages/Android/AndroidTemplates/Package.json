{
  "schemaVersion": 2,
  "name": "AndroidTemplates",
  "versionSource": "Version.json",
  "projects": {
    "files": {
      "adapter": "files",
      "mappings": [
        {
          "source": "Sources/Android/AndroidTemplates/PowerShell",
          "destination": "PowerShell"
        },
        {
          "source": "Sources/Android/AndroidTemplates/Templates/Application",
          "destination": "template_app"
        },
        {
          "source": "Sources/Android/AndroidTemplates/PowerShell/Read-AndroidSharedProps.ps1",
          "destination": "template_app/Scripts/PowerShell/Read-AndroidSharedProps.ps1"
        },
        {
          "source": "Sources/Android/AndroidTemplates/PowerShell/Remove-AndroidProject.ps1",
          "destination": "template_app/Scripts/PowerShell/Remove-AndroidProject.ps1"
        },
        {
          "source": "Version.json",
          "destination": "UdkVersion.json"
        }
      ],
      "artifacts": {
        "payload": {
          "root": "output",
          "path": "."
        }
      }
    }
  },
  "contents": [
    {
      "project": "files",
      "artifact": "payload",
      "destination": "."
    },
    {
      "file": "../../../LICENSE",
      "destination": "LICENSE.txt"
    },
    {
      "file": "README.md",
      "destination": "README.md"
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  }
}