{
  "schemaVersion": 2,
  "name": "AndroidBuildTools",
  "versionSource": "Version.json",
  "projects": {
    "files": {
      "adapter": "files",
      "mappings": [
        {
          "source": "Sources/Android/AndroidBuildTools/PowerShell",
          "destination": "tools"
        },
        {
          "source": "Sources/Android/AndroidBuildTools/Cmake",
          "destination": "cmake"
        },
        {
          "source": "Sources/Android/AndroidBuildTools/Gradle",
          "destination": "gradle"
        },
        {
          "source": "Projects/Gradle/AndroidBuildTools",
          "destination": "gradle"
        },
        {
          "source": "Sources/Android/AndroidBuildTools/ApplicationFramework",
          "destination": "build/native/Android/AndroidBuildTools/ApplicationFramework"
        },
        {
          "source": "Includes/Android/AndroidBuildTools/UniversalDevKit/Android/AndroidBuildTools/ApplicationFramework",
          "destination": "build/native/include/UniversalDevKit/Android/AndroidBuildTools/ApplicationFramework"
        },
        {
          "source": "Projects/Cmake/AndroidBuildTools/ApplicationFramework/CMakeLists.txt",
          "destination": "build/native/Android/AndroidBuildTools/ApplicationFramework/CMakeLists.txt"
        },
        {
          "source": "Scripts/Android/ResolveToolchain.ps1",
          "destination": "tools/Android/ResolveToolchain.ps1"
        },
        {
          "source": "Scripts/Android/Toolchain.json",
          "destination": "tools/Android/Toolchain.json"
        }
      ]
    }
  },
  "contents": [
    {
      "project": "files",
      "root": "output",
      "destination": "."
    },
    {
      "source": ".",
      "include": [
        "LICENSE",
        "Packages/Android/AndroidBuildTools/README.md"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "LICENSE": "LICENSE.txt"
      }
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  }
}