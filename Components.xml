    <Component>Projects/Components/Application/UdkCli.VSIX.xml</Component>
    <Component>Projects/Components/Application/XamlCompiler.xml</Component>
  </Components>
  <Generation>
    <Integration>
      <CoreExportHeader>Includes/Core/UniversalDevKit/Export.h</CoreExportHeader>
      <SourcesTargets>Projects/MsBuild/UniversalDevKit.Sources.targets</SourcesTargets>
      <VersionSource>Version.json</VersionSource>
      <VersionHeader>Includes/Core/UniversalDevKit/Version.h</VersionHeader>
      <VersionProps>Projects/MsBuild/UniversalDevKit.Version.props</VersionProps>
    </Integration>
    <MSBuild>
      <Solution>UniversalDevKit.sln</Solution>
      <SolutionFolder>
        <Rule>
          <Template>Projects/MsBuild/{kind:title}/{name}</Template>
        </Rule>
      </SolutionFolder>
      <ProjectDirectory>
        <Rule>
          <Template>Projects/MsBuild/{kind:title}/{name}</Template>
        </Rule>
      </ProjectDirectory>
      <ProjectNames>
        <ProjectName>
          <When artifact="sharedItems" />
          <Template>UniversalDevKit.{name}.Shared</Template>
        </ProjectName>
        <ProjectName>
          <When artifact="dependencies" />
          <Template>UniversalDevKit.{name}.Dependencies</Template>
        </ProjectName>
        <ProjectName>
          <When artifact="headerCheck" />
          <Template>UniversalDevKit.{name}.HeaderCheck</Template>
        </ProjectName>
        <ProjectName>
          <When artifact="project"
                variant="static;dynamic" />
          <Template>UniversalDevKit.{name}.{variant:title}</Template>
        </ProjectName>
        <ProjectName>
          <When artifact="project"
                projectType="classLibrary" />
          <Template>{name}.{framework}</Template>
        </ProjectName>
        <ProjectName>
          <Template>{name}</Template>
        </ProjectName>
      </ProjectNames>
      <Configurations>Debug;Release</Configurations>
      <Platforms>x64</Platforms>
      <NativeProps>
        <Prop>Projects/MsBuild/BuildLayout.props</Prop>
      </NativeProps>
    </MSBuild>
  </Generation>
</ComponentRegistry>