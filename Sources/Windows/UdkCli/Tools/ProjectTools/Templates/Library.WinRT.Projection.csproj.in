<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by ProjectTools. Edit the WinRT component description. -->
<Project>
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">@DEFAULTPLATFORM@</Platform>
    <BaseIntermediateOutputPath>@ARTIFACTS@projection\obj\$(Platform)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>@FRAMEWORK@</TargetFramework>
    <AssemblyName>@ASSEMBLY@</AssemblyName>
    <RootNamespace>@COMPONENT@</RootNamespace>
    <OutputPath>@ARTIFACTS@projection\bin\$(Platform)\$(Configuration)\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <CsWinRTIncludes>@COMPONENT@</CsWinRTIncludes>
    <CsWinRTWindowsMetadata>10.0.26100.0</CsWinRTWindowsMetadata>
    <UniversalDevKitWinRTManifestTasks>@TASKDLL@</UniversalDevKitWinRTManifestTasks>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);__UniversalDevKitPackWinRT</TargetsForTfmSpecificContentInPackage>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <UniversalDevKitWinRTPackagePlatforms Condition="'$(UniversalDevKitWinRTPackagePlatforms)' == ''">@PLATFORMS@</UniversalDevKitWinRTPackagePlatforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" PrivateAssets="build;buildTransitive;analyzers;contentfiles" />
    <ProjectReference Include="@NATIVE@" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="@TASKPROJECT@" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="Platform;RuntimeIdentifier;SelfContained" />
@DEPENDENCIES@
  </ItemGroup>
  <UsingTask TaskName="UniversalDevKit.WinRT.ReadActivationManifest" AssemblyFile="$(UniversalDevKitWinRTManifestTasks)" />
  <Target Name="__UniversalDevKitWinRTInputs" BeforeTargets="CsWinRTPrepareProjection" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="@NATIVE@" Targets="__UniversalDevKitGetWinRTArtifacts" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="__UniversalDevKitWinRTArtifact" />
    </MSBuild>
    <ItemGroup>
      <CsWinRTInputs Include="@(__UniversalDevKitWinRTArtifact->'%(WinMDPath)')" Condition="'%(__UniversalDevKitWinRTArtifact.WinMDPath)' != ''" />
    </ItemGroup>
    <UniversalDevKit.WinRT.ReadActivationManifest WinMD="@(CsWinRTInputs)" DllName="@COMPONENT@.dll" Output="@FRAGMENT@" />
    <MSBuild Projects="@(__UniversalDevKitMetadataProject)" Targets="__UniversalDevKitGetWinRTArtifacts" Properties="Configuration=$(Configuration);Platform=$(Platform)" Condition="'@(__UniversalDevKitMetadataProject)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="__UniversalDevKitReferencedArtifact" />
    </MSBuild>
    <ItemGroup>
      <CsWinRTInputs Include="@(__UniversalDevKitReferencedArtifact->'%(WinMDPath)')" Condition="'%(__UniversalDevKitReferencedArtifact.WinMDPath)' != ''" />
    </ItemGroup>
  </Target>
  <Target Name="__UniversalDevKitPackWinRT" DependsOnTargets="Build">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64' and '$(Platform)' != 'Win32'" Text="Specify Platform=x64, ARM64 or Win32 when packing a WinRT projection." />
    <ItemGroup>
      <__UniversalDevKitPackagePlatform Include="$(UniversalDevKitWinRTPackagePlatforms)" />
    </ItemGroup>
    <MSBuild Projects="@NATIVE@" Targets="Build;__UniversalDevKitGetWinRTArtifacts" Properties="Configuration=$(Configuration);Platform=%(__UniversalDevKitPackagePlatform.Identity)">
      <Output TaskParameter="TargetOutputs" ItemName="__UniversalDevKitPackageArtifact" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(__UniversalDevKitPackageArtifact)">
        <PackagePath>runtimes\%(__UniversalDevKitPackageArtifact.RuntimeIdentifier)\native</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@FRAGMENT@" PackagePath="buildTransitive\@COMPONENT@.activation.manifest" />
      <TfmSpecificPackageFile Include="@PACKAGETARGETS@" PackagePath="buildTransitive\$(PackageId).targets" />
      <TfmSpecificPackageFile Include="@RUNTIMETARGETS@" PackagePath="buildTransitive\UniversalDevKit.WinRT.Runtime.g.targets" />
      <TfmSpecificPackageFile Include="@TASKDIRECTORY@*.dll" PackagePath="tools\" />
    </ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>