<Window x:Class="UniversalDevKit.UdkCli.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDK CLI Setup"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock x:Name="VersionText"
                   FontSize="24"
                   Margin="0,0,0,12" />
        <TextBlock x:Name="InstallLocationLabel"
                   Text="Install for the current user in"
                   Margin="0,0,0,4" />
        <DockPanel>
            <Button x:Name="BrowseButton"
                    DockPanel.Dock="Right"
                    Content="Browse…"
                    Margin="8,0,0,0"
                    Padding="10,4"
                    Click="OnBrowseClick" />
            <TextBlock x:Name="InstallDirectoryText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Text="Installing the Visual Studio extension…"
                   Visibility="{Binding Visibility, ElementName=ExtensionProgress}"
                   Margin="0,12,0,0" />
        <DockPanel x:Name="ExtensionProgress" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                       Text="{Binding Value, ElementName=ExtensionProgressBar, StringFormat={}{0:0}%}" />
            <ProgressBar x:Name="ExtensionProgressBar" Height="8" />
        </DockPanel>
        <StackPanel Orientation="Horizontal"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right">
            <Button x:Name="InstallButton"
                    Content="Install"
                    IsDefault="True"
                    MinWidth="100"
                    Padding="10,5"
                    Click="OnInstallClick" />
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>