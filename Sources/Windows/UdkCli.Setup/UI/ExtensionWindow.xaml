<Window x:Class="UniversalDevKit.UdkCli.Setup.ExtensionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UDK CLI Setup — Visual Studio extension"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock Text="The Visual Studio extension is optional."
                   Margin="0,12,0,0" />
        <ScrollViewer MaxHeight="180"
                      Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right">
            <Button x:Name="InstallExtensionButton"
                    Content="Install extension"
                    IsDefault="True"
                    MinWidth="120"
                    Padding="10,5"
                    Click="OnInstallExtensionClick" />
            <Button x:Name="SkipButton"
                    Content="Skip"
                    IsCancel="True"
                    MinWidth="100"
                    Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>