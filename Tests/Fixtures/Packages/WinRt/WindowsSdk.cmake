get_filename_component(winrtSdkRoot "[HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows Kits\\Installed Roots;KitsRoot10]" ABSOLUTE)
set(winrtSdkVersion "${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}")
set(winrtSdkBin "${winrtSdkRoot}/bin/${winrtSdkVersion}/x64")
set(winrtSdkInclude "${winrtSdkRoot}/Include/${winrtSdkVersion}")
set(winrtWindowsMetadata "${winrtSdkRoot}/UnionMetadata/${winrtSdkVersion}/Windows.winmd")
set(winrtMetadataDirectory "${winrtSdkRoot}/UnionMetadata/${winrtSdkVersion}")
foreach(nativePath IN ITEMS winrtWindowsMetadata winrtMetadataDirectory)
    file(TO_NATIVE_PATH "${${nativePath}}" ${nativePath})
endforeach()
foreach(sdkFile IN ITEMS "${winrtSdkBin}/midlrt.exe" "${winrtSdkBin}/cppwinrt.exe" "${winrtWindowsMetadata}")
    if(NOT EXISTS "${sdkFile}")
        message(FATAL_ERROR "Windows SDK WinRT tool or metadata missing: ${sdkFile}")
    endif()
endforeach()