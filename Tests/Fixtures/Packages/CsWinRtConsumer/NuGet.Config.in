<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="TestFeed" value="{{FEED}}" />
    <add key="NuGetOrg" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="TestFeed"><package pattern="UniversalDevKit.TestPackages.*" /></packageSource>
    <packageSource key="NuGetOrg"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>