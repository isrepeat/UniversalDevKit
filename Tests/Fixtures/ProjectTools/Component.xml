<Component>
  <Name>Probe</Name>
  <Kind>compiled</Kind>
  <Variants>
    <Variant>static</Variant>
    <Variant>dynamic</Variant>
  </Variants>
  <Files>
    <Header>Source/**/*.h</Header>
    <Source>Source/**/*.cpp</Source>
    <Group name="Examples">
      <File>NewFile.cpp</File>
    </Group>
    <MSBuildProps>Custom.props</MSBuildProps>
    <MSBuildTargets>Custom.targets</MSBuildTargets>
  </Files>
  <Filters>
    <Filter filter="{Tree:Project}">
      <Match>Source/Prob?.cpp</Match>
    </Filter>
    <Filter filter="{Tree:Project}/Build">
      <Match>Custom.props</Match>
    </Filter>
    <Filter filter="{Tree:Project}/Examples">
      <GroupRef>Examples</GroupRef>
    </Filter>
    <Filter filter="{Tree:Project}/Implementation"
            preserveTree="true">
      <Match>Source/*/**/*.cpp</Match>
    </Filter>
  </Filters>
  <ExcludeSources>
    <Source>Source/excluded/**</Source>
  </ExcludeSources>
  <Requirements>
    <CxxStandard>20</CxxStandard>
  </Requirements>
  <Compile>
    <IncludeDirectories>
      <IncludeDirectory>Source</IncludeDirectory>
    </IncludeDirectories>
    <PrecompiledHeader>notUsing</PrecompiledHeader>
  </Compile>
</Component>