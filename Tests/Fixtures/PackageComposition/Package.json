{
  "schemaVersion": 2,
  "name": "CompositionProbe",
  "versionSource": "Version.json",
  "projects": "Projects.json",
  "contents": [
    {
      "project": "Managed",
      "root": "output",
      "path": "Probe.dll",
      "destination": "lib/net8.0"
    },
    {
      "project": "Native",
      "root": "output",
      "destination": "."
    },
    {
      "project": "CMake",
      "root": "install",
      "destination": "native"
    },
    {
      "source": ".",
      "include": [
        "CMake/marker.txt"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "CMake/marker.txt": "README.txt"
      }
    }
  ],
  "deliveries": {
    "NuGet": "Delivery.json"
  }
}