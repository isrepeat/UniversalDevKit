<?xml version="1.0" encoding="utf-8"?>
<!-- Package-specific integration. Edit this file directly. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UniversalDevKitRuntime Condition="'$(UniversalDevKitRuntime)' == ''">Dynamic</UniversalDevKitRuntime>
    <__UniversalDevKitHeaderProbePackageRoot>$(MSBuildThisFileDirectory)..\..\</__UniversalDevKitHeaderProbePackageRoot>
    <__UniversalDevKitHeaderProbePackageVersion>$(__UniversalDevKitHeaderProbePackageVersion)</__UniversalDevKitHeaderProbePackageVersion>
    <UniversalDevKitHeaderProbeLinkage Condition="'$(UniversalDevKitHeaderProbeLinkage)' == ''">Shared</UniversalDevKitHeaderProbeLinkage>
  </PropertyGroup>
  <Import Project="Generated\Settings.targets" />
  <ItemGroup>
    <__UniversalDevKitNuGetRoot Include="$(UniversalDevKitComponents)" />
  </ItemGroup>
  <Target Name="__UniversalDevKitHeaderProbeValidateNuGet" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="UniversalDevKit.HeaderProbe: only Windows x64 is packaged." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="UniversalDevKit.HeaderProbe: select Debug or Release." />
    <Error Condition="'$(UniversalDevKitComponents)' == ''" Text="Set UniversalDevKitComponents to explicitly selected root components." />
    <Error Condition="!$([System.String]::Copy(';$(__UniversalDevKitHeaderProbeValidModes);').Contains(';$(UniversalDevKitHeaderProbeLinkage);'))" Text="UniversalDevKit.HeaderProbe: unsupported linkage." />
    <Error Condition="'$(UniversalDevKitRuntime)' != 'Static' and '$(UniversalDevKitRuntime)' != 'Dynamic'" Text="UniversalDevKitRuntime must be Static (MT) or Dynamic (MD)." />
    <Error Condition="'$(__UniversalDevKitHeaderProbeHasBinaries)' == 'true' and '$(PlatformToolset)' != '$(__UniversalDevKitHeaderProbeExpectedToolset)'" Text="UniversalDevKit.HeaderProbe: package requires toolset $(__UniversalDevKitHeaderProbeExpectedToolset)." />
    <Error Condition="'$(__UniversalDevKitHeaderProbeHasBinaries)' == 'true' and '$(VCToolsVersion)' != '$(__UniversalDevKitHeaderProbeExpectedTools)'" Text="UniversalDevKit.HeaderProbe: package requires MSVC tools $(__UniversalDevKitHeaderProbeExpectedTools)." />
    <Error Condition="'$(__UniversalDevKitHeaderProbePackageRoot)' == ''" Text="UniversalDevKit package import is missing." />

  </Target>
  <Target Name="__UniversalDevKitHeaderProbeCopyNuGetRuntime" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="@(__UniversalDevKitHeaderProbeNuGetRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>