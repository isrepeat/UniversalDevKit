{
  "schemaVersion": 2,
  "name": "HeaderProbe",
  "versionSource": "../../../Version.json",
  "projects": {
    "windows": {
      "adapter": "udk-native",
      "component": "HeaderProbe",
      "generator": "Visual Studio 18 2026",
      "buildDirectory": "!artifacts/packages/nuget/HeaderProbe",
      "artifacts": {
        "payload": {
          "root": "output",
          "path": "."
        }
      }
    }
  },
  "contents": [
    {
      "project": "windows",
      "artifact": "payload",
      "destination": ".",
      "deliveries": [
        "NuGet"
      ]
    },
    {
      "file": "../../../LICENSE",
      "destination": "LICENSE.txt",
      "deliveries": [
        "NuGet"
      ]
    },
    {
      "file": "../../Build/NuGet/README.md",
      "destination": "README.md",
      "deliveries": [
        "NuGet"
      ]
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  },
  "releaseDependencies": [
    {
      "package": "../HeaderLeaf/Package.json",
      "delivery": "NuGet",
      "when": [
        "NuGet"
      ]
    }
  ]
}