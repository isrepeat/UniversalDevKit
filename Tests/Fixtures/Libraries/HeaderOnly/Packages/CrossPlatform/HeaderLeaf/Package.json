{
  "schemaVersion": 2,
  "name": "HeaderLeaf",
  "version": "0.1.0",
  "projects": {
    "windows": {
      "adapter": "udk-native",
      "component": "HeaderLeaf",
      "cmakeGeneratorWindows": "Visual Studio 18 2026"
    }
  },
  "contents": [
    {
      "project": "windows",
      "root": "output",
      "destination": ".",
      "deliveries": [
        "NuGet"
      ]
    },
    {
      "source": ".",
      "include": [
        "LICENSE",
        "Packages/Build/NuGet/README.md"
      ],
      "destination": ".",
      "preserveHierarchy": false,
      "rename": {
        "LICENSE": "LICENSE.txt"
      },
      "deliveries": [
        "NuGet"
      ]
    }
  ],
  "deliveries": {
    "NuGet": "Delivery/NuGet/Delivery.json"
  }
}