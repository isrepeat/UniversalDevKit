cmake_minimum_required(VERSION 3.22)
include("${REPOSITORY}/Projects/Cmake/BinaryReleasePolicy.cmake")
include("${REPOSITORY}/Projects/Cmake/BuildIdentity.cmake")
set(udkRelease_platforms Windows)
set(udkRelease_architectures x64)
set(udkRelease_compilerIds MSVC)
set(udkRelease_compilerVersions 19.51.36260.0)
set(udkRelease_toolsets v145)
set(udkRelease_runtimes "${RUNTIME}")
set(udkRelease_configurations Debug Release)
set(udkRelease_variants Static Dynamic)
if(DEFINED REJECT_FIELD)
    set(udkRelease_${REJECT_FIELD} unsupported)
endif()
udkValidateBinaryRelease("${REPOSITORY}/BinaryReleasePolicy.json")
file(MAKE_DIRECTORY "${WORKSPACE}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/Identity.txt.in" "${WORKSPACE}/identity.txt" COPYONLY)
set(identity "Windows|AMD64|8|cl.exe|19.51.36260.0|v145|Dynamic")
if(IDENTITY_CASE STREQUAL "Compiler")
    string(REPLACE "cl.exe" "other-cl.exe" identity "${identity}")
elseif(IDENTITY_CASE STREQUAL "CompilerVersion")
    string(REPLACE "19.51.36260.0" "0.0" identity "${identity}")
elseif(IDENTITY_CASE STREQUAL "Architecture")
    string(REPLACE "AMD64|8" "x86|4" identity "${identity}")
elseif(IDENTITY_CASE STREQUAL "Runtime")
    string(REPLACE "Dynamic" "Static" identity "${identity}")
endif()
udkValidateBuildIdentity("${WORKSPACE}/identity.txt" "${identity}")