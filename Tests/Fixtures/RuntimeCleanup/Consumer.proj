<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Debug</Configuration>
    <Platform>x64</Platform>
  </PropertyGroup>
  <ItemGroup Condition="'$(Deliver)' == 'true'">
    <__UniversalDevKitRuntimeProject Include="$(MSBuildThisFileDirectory)Library.proj" />
  </ItemGroup>
  <Target Name="Build" />
  <Import Project="../../../Projects/MsBuild/UniversalDevKit.Runtime.targets" />
</Project>