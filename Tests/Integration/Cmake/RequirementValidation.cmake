include("${CMAKE_CURRENT_LIST_DIR}/../../../Projects/Cmake/ComponentRequirements.cmake")
set(CMAKE_SYSTEM_NAME Windows)
if(TEST_CASE STREQUAL "unknown")
    udkReadComponentRequirements("{\"requirements\":{\"unknown\":true}}")
elseif(TEST_CASE STREQUAL "standard")
    udkReadComponentRequirements("{\"requirements\":{\"cxxStandard\":17}}")
elseif(TEST_CASE STREQUAL "threads")
    udkReadComponentRequirements("{\"requirements\":{\"threads\":\"true\"}}")
else()
    udkReadComponentRequirements("{}")
    if(NOT componentRequiredStandard EQUAL 20)
        message(FATAL_ERROR "Default language standard must be C++20")
    endif()
    udkReadComponentRequirements("{\"requirements\":{\"cxxStandard\":20,\"threads\":true},\"platformRequirements\":{\"Windows\":{\"linkLibraries\":[\"ws2_32\"]}}}")
    if(NOT componentRequiredStandard EQUAL 20 OR NOT componentRequiresThreads OR NOT componentSystemLibraries STREQUAL "ws2_32")
        message(FATAL_ERROR "Invalid requirement translation")
    endif()
    foreach(testCase IN ITEMS unknown standard threads)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_CASE=${testCase}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE testResult OUTPUT_VARIABLE testOutput ERROR_VARIABLE testError)
        if(testResult EQUAL 0)
            message(FATAL_ERROR "Invalid requirement accepted: ${testCase}")
        endif()
    endforeach()
    message(STATUS "Common requirement validation passed")
endif()